---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/cart/CartDrawer.tsx';

interface Props {
	title?: string;
	description?: string;
	/** Solid navbar (for pages without a dark hero behind it). Homepage passes false. */
	solid?: boolean;
	/** Hide footer (e.g. focused checkout). */
	hideFooter?: boolean;
}

const {
	title = 'VitalGreenz - Premium Indian Tea',
	description = 'Experience the heritage of Indian tea. Small-grower sourced, sustainably cultivated, crafted for exceptional taste.',
	solid = true,
	hideFooter = false,
} = Astro.props;

const wpOrigin = new URL(import.meta.env.PUBLIC_WORDPRESS_URL).origin;

// Absolute URLs for social sharing (falls back to the request origin locally).
const base = Astro.site ?? Astro.url;
const ogImage = new URL('/og.png', base).href;
const canonicalURL = new URL(Astro.url.pathname, base).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Runs before paint: marks JS available so scroll-reveal hides content ONLY
		     when JS can reveal it again (fail-open if JS is slow/blocked/disabled). -->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Fast product images: warm up the WordPress media origin early -->
		<link rel="preconnect" href={wpOrigin} crossorigin />
		<link rel="dns-prefetch" href={wpOrigin} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="VitalGreenz" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="VitalGreenz — premium Indian tea" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#10241a" />
	</head>
	<body>
		<Navbar solid={solid} />
		<slot />
		{!hideFooter && <Footer />}
		<CartDrawer client:load />

		<script>
			// Weighted / inertia scroll via Lenis (skipped for reduced-motion users).
			import Lenis from 'lenis';

			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduce) {
				const lenis = new Lenis({
					lerp: 0.085, // lower = heavier / more inertia
					wheelMultiplier: 1,
					touchMultiplier: 1.4,
					smoothWheel: true,
				});
				(window as any).lenis = lenis;

				const raf = (time: number) => {
					lenis.raf(time);
					requestAnimationFrame(raf);
				};
				requestAnimationFrame(raf);

				// Smoothly scroll in-page anchor links through Lenis.
				document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
					a.addEventListener('click', (e) => {
						const id = a.getAttribute('href')!;
						if (id.length < 2) return;
						const target = document.querySelector(id);
						if (!target) return;
						e.preventDefault();
						lenis.scrollTo(target as HTMLElement, { offset: -72, duration: 1.4 });
					});
				});
			}
		</script>

		<!-- Inline (not bundled) so reveals fire immediately, without waiting on a
		     separate JS download that the hero video would otherwise starve. -->
		<script is:inline>
			(function () {
				// Scroll-reveal: reveal elements once as they enter the viewport.
				var setup = function () {
					var els = document.querySelectorAll('[data-reveal]');
					if (!('IntersectionObserver' in window) || !els.length) {
						els.forEach(function (el) {
							el.classList.add('is-visible');
						});
						return;
					}
					var io = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (entry) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									io.unobserve(entry.target);
								}
							});
						},
						// Pre-fire: reveal sections ~40% of a viewport BEFORE they scroll
						// into view, so content is already there as you reach it (and the
						// first section below the hero reveals at load).
						{ threshold: 0, rootMargin: '0px 0px 40% 0px' }
					);
					els.forEach(function (el) {
						io.observe(el);
					});

					// Safety net (runs promptly, NOT on window.load which the big video
					// delays): reveal anything within ~1.4 viewports so nothing stays blank.
					setTimeout(function () {
						els.forEach(function (el) {
							if (el.getBoundingClientRect().top < window.innerHeight * 1.4) {
								el.classList.add('is-visible');
							}
						});
					}, 250);
				};

				// Count-up numbers (elements with [data-countup]).
				var counters = function () {
					var nums = document.querySelectorAll('[data-countup]');
					if (!nums.length) return;
					var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					if (reduceMotion) {
						nums.forEach(function (el) {
							var target = parseFloat(el.dataset.countup || '0');
							el.textContent = target.toLocaleString() + (el.dataset.suffix || '');
						});
						return;
					}
					var io = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (entry) {
								if (!entry.isIntersecting) return;
								var el = entry.target;
								var target = parseFloat(el.dataset.countup || '0');
								var suffix = el.dataset.suffix || '';
								var dur = 1400;
								var start = 0;
								var step = function (ts) {
									if (!start) start = ts;
									var p = Math.min((ts - start) / dur, 1);
									var eased = 1 - Math.pow(1 - p, 3);
									el.textContent = Math.round(target * eased).toLocaleString() + suffix;
									if (p < 1) requestAnimationFrame(step);
								};
								requestAnimationFrame(step);
								io.unobserve(el);
							});
						},
						{ threshold: 0.5 }
					);
					nums.forEach(function (n) {
						io.observe(n);
					});
				};

				setup();
				counters();
				document.addEventListener('astro:after-swap', function () {
					setup();
					counters();
				});
			})();
		</script>

		<!-- Product card image carousel (delegated — one handler for all cards) -->
		<script is:inline>
			document.addEventListener('click', function (e) {
				var dot = e.target.closest && e.target.closest('[data-dot]');
				if (!dot) return;
				var card = dot.closest('[data-card]');
				if (!card) return;
				var img = card.querySelector('[data-media-img]');
				var raw = card.getAttribute('data-images');
				if (!img || !raw) return;
				var imgs = JSON.parse(raw);
				var i = parseInt(dot.getAttribute('data-dot'), 10);
				if (!imgs[i]) return;
				img.setAttribute('src', imgs[i].s);
				if (imgs[i].ss) img.setAttribute('srcset', imgs[i].ss);
				card.querySelectorAll('[data-dot]').forEach(function (d) {
					d.setAttribute('data-active', d === dot ? 'true' : 'false');
				});
			});
		</script>
	</body>
</html>
