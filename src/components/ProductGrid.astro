---
import { getProducts } from '../lib/woocommerce';
import ProductCard from './ProductCard.astro';

// Curated display order (by WooCommerce product name).
// Note: "Premium Tea" is the "Premium Tea Granules" listing on the price chart.
const DISPLAY_ORDER = [
	'Premium Rose Tea',
	'Premium Saffron Tea',
	'Indian Masala Tea',
	'Premium Tea',
	'Premium Green Tea',
	'Premium Orthodox Black Tea',
];

const rank = (name: string) => {
	const i = DISPLAY_ORDER.indexOf(name);
	return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};

const products = (await getProducts(100)).sort((a, b) => rank(a.name) - rank(b.name));
---

<section class="px-6 py-16">
	<div class="mx-auto max-w-6xl">
		<h2 class="mb-8 text-2xl font-bold tracking-tight text-emerald-950">Our teas</h2>
		<div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
			{products.map((product) => <ProductCard product={product} />)}
		</div>
	</div>
</section>
