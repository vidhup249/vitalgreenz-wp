---
/**
 * Layered tea-garden hills, line-art style — an original abstraction of the
 * plantation-row illustration in the product posters (rolling rows rather
 * than a literal figure, which keeps this honest as a new asset).
 */
---

<svg
	class="garden-hills"
	viewBox="0 0 1440 220"
	preserveAspectRatio="none"
	aria-hidden="true"
>
	<path
		class="garden-hills-back"
		d="M0,120 C240,60 480,160 720,100 C960,40 1200,140 1440,80 L1440,220 L0,220 Z"
	/>
	<path
		class="garden-hills-mid"
		d="M0,160 C300,110 600,190 900,140 C1100,110 1300,170 1440,130 L1440,220 L0,220 Z"
	/>
	<path
		class="garden-hills-front"
		d="M0,190 C360,150 720,200 1080,170 C1200,160 1320,190 1440,175 L1440,220 L0,220 Z"
	/>
</svg>
