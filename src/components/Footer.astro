---
const columns = [
	{
		title: 'Shop',
		mobileHidden: true, // hidden on mobile per request
		links: [
			{ label: 'All teas', href: '#shop' },
			{ label: 'Blend Lab', href: '#blend' },
			{ label: 'Bestsellers', href: '#shop' },
			{ label: 'Gift sets', href: '#shop' },
		],
	},
	{
		title: 'Company',
		mobileHidden: false,
		links: [
			{ label: 'Our story', href: '#story' },
			{ label: 'Sustainability', href: '#story' },
			{ label: 'Small growers', href: '#story' },
			{ label: 'FAQ', href: '#faq' },
		],
	},
];

const socials = [
	{ label: 'Instagram', href: '#', icon: 'instagram', color: '#E4405F' },
	{ label: 'Facebook', href: '#', icon: 'facebook', color: '#1877F2' },
	{ label: 'YouTube', href: '#', icon: 'youtube', color: '#FF0000' },
	{ label: 'WhatsApp', href: '#', icon: 'whatsapp', color: '#25D366' },
];
---

<!-- Final CTA band -->
<section class="relative isolate overflow-hidden bg-ink px-5 py-24 text-cream sm:px-8 sm:py-32">
	<!-- Dimmed tea-pour video texture -->
	<video
		class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		aria-hidden="true"
	>
		<source src="/videos/tea-pour.mp4" type="video/mp4" />
	</video>
	<div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/70 via-ink/60 to-ink/80"></div>
	<div class="animate-float absolute -left-10 top-10 h-40 w-40 rounded-full bg-brand/40 blur-3xl"></div>
	<div class="animate-float absolute -right-10 bottom-10 h-52 w-52 rounded-full bg-saffron/20 blur-3xl" style="animation-delay:-3s"></div>
	<div class="relative mx-auto max-w-4xl text-center">
		<p data-reveal="fade" class="eyebrow justify-center text-cream/60">Start today</p>
		<h2 data-reveal class="display mt-6 text-[clamp(2.5rem,8vw,5.5rem)]">
			Brew something<br /><span class="text-lime">worth savouring.</span>
		</h2>
		<div data-reveal="fade" class="mt-10 flex justify-center">
			<a
				href="#shop"
				class="group inline-flex items-center gap-2 rounded-full bg-lime px-8 py-4 text-sm font-semibold text-ink transition duration-300 hover:bg-cream"
			>
				Explore the collection
				<span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
			</a>
		</div>
	</div>
</section>

<footer class="bg-ink px-5 pb-10 text-cream sm:px-8">
	<div class="mx-auto max-w-7xl border-t border-white/10 pt-16">
		<div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
			<!-- Brand + newsletter -->
			<div>
				<img src="/images/vg-logo-w.png" alt="Wayomile" width="615" height="444" class="h-16 w-auto" />
				<p class="mt-4 max-w-xs text-cream/70 text-pretty">
					Sip the legacy, taste the tradition. Premium Indian tea from small growers to your cup.
				</p>

				<form class="mt-6 flex max-w-sm items-center rounded-full bg-white/10 p-1.5 pl-5 focus-within:bg-white/15" onsubmit="return false">
					<input
						type="email"
						required
						placeholder="Your email"
						aria-label="Email address"
						class="min-w-0 flex-1 bg-transparent text-sm text-cream placeholder:text-cream/50 focus:outline-none"
					/>
					<button class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-lime text-ink transition hover:scale-105" aria-label="Subscribe">
						↗
					</button>
				</form>
			</div>

			<!-- Link columns -->
			{
				columns.map((col) => (
					<div class={col.mobileHidden ? 'hidden md:block' : ''}>
						<h3 class="text-sm font-semibold uppercase tracking-wider text-cream/50">{col.title}</h3>
						<ul class="mt-4 space-y-3">
							{col.links.map((l) => (
								<li>
									<a href={l.href} class="text-cream/80 transition hover:text-lime">{l.label}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}

			<!-- Social: colored icons on mobile (one line), text list on desktop -->
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-cream/50">Social</h3>

				<div class="mt-4 flex gap-3 md:hidden">
					{
						socials.map((s) => (
							<a
								href={s.href}
								aria-label={s.label}
								class="grid h-10 w-10 place-items-center rounded-full text-white transition hover:scale-110"
								style={`background:${s.color}`}
							>
								{s.icon === 'instagram' && (
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none" />
									</svg>
								)}
								{s.icon === 'facebook' && (
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
										<path d="M13.5 21v-7h2.3l.4-2.9h-2.7V9.3c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.1H8.2V14h2.3v7z" />
									</svg>
								)}
								{s.icon === 'youtube' && (
									<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
										<path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.7C19.3 5.2 12 5.2 12 5.2s-7.3 0-8.9.4A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.7 1.7c1.6.4 8.9.4 8.9.4s7.3 0 8.9-.4a2.5 2.5 0 0 0 1.7-1.7C23 15.2 23 12 23 12zM9.8 15.3V8.7l6.2 3.3z" />
									</svg>
								)}
								{s.icon === 'whatsapp' && (
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
										<path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.6.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5s0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.5a1 1 0 0 0-.8.4A3 3 0 0 0 5 8.9c0 1.5 1.1 2.9 1.2 3.1s2.1 3.3 5.2 4.6c.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4s.3-1.3.2-1.4-.2-.2-.5-.3zM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.3A10 10 0 1 0 12 2z" />
									</svg>
								)}
							</a>
						))
					}
				</div>

				<ul class="mt-4 hidden space-y-3 md:block">
					{
						socials.map((s) => (
							<li>
								<a href={s.href} class="text-cream/80 transition hover:text-lime">{s.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<!-- Contact + bottom -->
		<div class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm text-cream/60 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex flex-wrap gap-x-6 gap-y-1">
				<a href="tel:+919633816338" class="transition hover:text-lime">+91 9633816338</a>
				<a href="mailto:support@wayomile.in" class="transition hover:text-lime">support@wayomile.in</a>
			</div>
			<p>© {new Date().getFullYear()} Wayomile. All rights reserved.</p>
		</div>
	</div>
</footer>
