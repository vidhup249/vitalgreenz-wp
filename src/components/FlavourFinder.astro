---
import { getShopData, stripHtml, type WooProduct } from '../lib/woocommerce';
import FlavourFinder, { type FinderProduct } from './FlavourFinder.tsx';

const { products } = await getShopData();

const finderProducts: FinderProduct[] = products.map((p: WooProduct) => {
	const img = p.images?.[0];
	return {
		id: p.id,
		name: p.name,
		price: Number(p.on_sale ? p.prices.sale_price : p.prices.price),
		image: img?.thumbnail || img?.src || '',
		permalink: `/products/${p.slug}`,
		slug: p.slug,
		summary: stripHtml(p.short_description, 80),
	};
});
---

<section id="blend" class="relative overflow-hidden bg-sand px-5 py-24 sm:px-8 sm:py-32">
	<!-- Oversized playful watermark -->
	<span
		aria-hidden="true"
		class="pointer-events-none absolute -right-4 top-8 select-none text-[22vw] font-bold leading-none tracking-tighter text-ink/5 sm:top-4"
	>BLEND.</span>

	<div class="relative mx-auto max-w-6xl">
		<div class="max-w-2xl">
			<p data-reveal="fade" class="eyebrow text-ink/60">Find your blend</p>
			<h2 data-reveal class="display mt-5 text-[clamp(2rem,5.5vw,3.75rem)] text-ink">
				Not sure where to start? <span class="text-brand">We'll match you.</span>
			</h2>
			<p data-reveal="fade" class="mt-4 text-lg text-ink/65 text-pretty">
				One tap on the mood you're after and we'll point you to the blend that fits — then drop it
				straight in your basket.
			</p>
		</div>

		<div data-reveal class="mt-14">
			<FlavourFinder client:visible products={finderProducts} />
		</div>
	</div>
</section>
