---
import type { WooProduct } from '../lib/woocommerce';
import { formatPrice, stripHtml } from '../lib/woocommerce';
import AddToCart from './cart/AddToCart.tsx';

interface Props {
	product: WooProduct;
	index?: number;
}

const { product, index = 0 } = Astro.props;
const images = product.images?.slice(0, 5) ?? [];
const image = images[0];
const cat = product.categories.find((c) => c.name.toLowerCase() !== 'uncategorized');
const summary = stripHtml(product.short_description, 96);
const slugs = product.categories.map((c) => c.slug).join(' ');
const href = `/products/${product.slug}`;
const eager = index < 3;

const rating = Number(product.average_rating) || 0;
const hasRating = product.review_count > 0 && rating > 0;
const topRated = rating >= 4.5;

// Carousel image data (src + srcset) for the dot navigation.
const mediaData = JSON.stringify(images.map((i) => ({ s: i.src, ss: i.srcset })));
---

<article
	data-card
	data-category={slugs}
	data-images={mediaData}
	data-reveal
	style={`--reveal-delay:${(index % 3) * 90}ms`}
	class="group flex flex-col overflow-hidden rounded-3xl bg-paper ring-1 ring-ink/5 transition duration-500 hover:-translate-y-1 hover:shadow-[0_28px_70px_-30px_rgba(16,36,26,0.4)]"
>
	<!-- Media -->
	<div class="relative aspect-[4/3] overflow-hidden">
		<a href={href} class="block h-full w-full" aria-label={product.name}>
			{
				image && (
					<img
						data-media-img
						src={image.src}
						srcset={image.srcset}
						sizes="(min-width:1024px) 32vw, (min-width:640px) 45vw, 92vw"
						alt={image.alt || product.name}
						width="640"
						height="480"
						loading={eager ? 'eager' : 'lazy'}
						decoding="async"
						fetchpriority={eager ? 'high' : 'auto'}
						class="h-full w-full object-cover transition-transform duration-700 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
					/>
				)
			}
		</a>

		<!-- Category pills (top-left) -->
		<div class="pointer-events-none absolute left-3 top-3 flex flex-wrap gap-1.5">
			{cat && (
				<span class="rounded-full bg-white/85 px-3 py-1 text-xs font-semibold text-ink backdrop-blur">
					{cat.name}
				</span>
			)}
			{
				product.on_sale ? (
					<span class="rounded-full bg-saffron px-3 py-1 text-xs font-bold text-ink">Sale</span>
				) : (
					<span class="rounded-full bg-white/85 px-3 py-1 text-xs font-semibold text-ink backdrop-blur">
						Single-origin
					</span>
				)
			}
		</div>

		<!-- Rating (top-right) -->
		<div class="pointer-events-none absolute right-3 top-3">
			<span class="inline-flex items-center gap-1 rounded-full bg-white/85 px-2.5 py-1 text-xs font-bold text-ink backdrop-blur">
				<span class="text-saffron">★</span>
				{hasRating ? rating.toFixed(1) : 'New'}
			</span>
		</div>

		<!-- Carousel dots -->
		{
			images.length > 1 && (
				<div class="absolute inset-x-0 bottom-3 flex justify-center gap-1.5">
					<span class="flex items-center gap-1.5 rounded-full bg-white/40 px-2 py-1.5 backdrop-blur">
						{images.map((_, i) => (
							<button
								data-dot={i}
								data-active={i === 0 ? 'true' : 'false'}
								aria-label={`View image ${i + 1}`}
								class="h-1.5 rounded-full bg-ink/40 transition-all duration-300 data-[active=true]:w-5 data-[active=true]:bg-ink data-[active=false]:w-1.5"
							/>
						))}
					</span>
				</div>
			)
		}
	</div>

	<!-- Body -->
	<div class="flex flex-1 flex-col p-5">
		<div class="flex items-start justify-between gap-3">
			<h3 class="text-lg font-bold leading-snug tracking-tight">
				<a href={href} class="transition-colors hover:text-brand">{product.name}</a>
			</h3>
			{topRated && (
				<span class="mt-0.5 shrink-0 rounded-full border border-ink/15 px-3 py-1 text-xs font-medium text-ink/70">
					Top rated
				</span>
			)}
		</div>

		<p class="mt-1.5 text-sm text-ink/45">Freshly packed · Ships in 48h</p>
		<p class="mt-2 line-clamp-2 text-sm text-ink/60 text-pretty">{summary}</p>

		<div class="mt-5 flex items-center justify-between gap-3 pt-1">
			<div class="flex items-baseline gap-2">
				{
					product.on_sale ? (
						<>
							<span class="text-lg font-bold text-ink">{formatPrice(product.prices.sale_price, product.prices)}</span>
							<span class="text-sm text-ink/40 line-through">{formatPrice(product.prices.regular_price, product.prices)}</span>
						</>
					) : (
						<span class="text-lg font-bold text-ink">{formatPrice(product.prices.price, product.prices)}</span>
					)
				}
			</div>
			<AddToCart
				client:visible
				id={product.id}
				name={product.name}
				price={Number(product.on_sale ? product.prices.sale_price : product.prices.price)}
				image={image?.thumbnail || image?.src || ''}
				slug={product.slug}
			/>
		</div>
	</div>
</article>
