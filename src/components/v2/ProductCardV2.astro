---
import type { WooProduct } from '../../lib/woocommerce';
import { formatPrice, stripHtml } from '../../lib/woocommerce';
import AddToCart from '../cart/AddToCart.tsx';

interface Props {
	product: WooProduct;
	index?: number;
}

const { product, index = 0 } = Astro.props;

const images = product.images?.slice(0, 5) ?? [];
const image = images[0];
const cat = product.categories.find((c) => c.name.toLowerCase() !== 'uncategorized');

/** Truncate on a word boundary — a mid-word cut reads as a bug at this scale. */
const clip = (text: string, max: number) => {
	if (text.length <= max) return text;
	const cut = text.slice(0, max);
	const space = cut.lastIndexOf(' ');
	return (space > max * 0.6 ? cut.slice(0, space) : cut).trimEnd().replace(/[.,;:—-]$/, '') + '…';
};

// The brief gives each product a tagline ("The Romantic One - Floral &
// Refreshing") ahead of its description. It is authored as a leading
// <strong>, so lift it out and show it as the kicker rather than letting it
// run into the summary text.
const raw = product.short_description || '';
const taglineMatch = raw.match(/<strong>([\s\S]*?)<\/strong>/i);
const tagline = taglineMatch ? stripHtml(taglineMatch[1], 200) : null;
const bodyHtml = taglineMatch
	? raw.replace(/<p>\s*<strong>[\s\S]*?<\/strong>\s*<\/p>/i, '')
	: raw;

// Shown in full — no clamp — so the whole description reads at a glance.
// The generous cap is only a guard against a future runaway description.
const summary = clip(stripHtml(bodyHtml, 600), 260);
const slugs = product.categories.map((c) => c.slug).join(' ');
const href = `/products/${product.slug}`;
const eager = index < 3;

---

<article data-card data-product data-category={slugs} style={`--i:${index % 3}`} class="pcard">
	<div class="pcard-media">
		<a href={href} aria-label={product.name}>
			{/* Every image lives in the track, so hovering slides between them
			    instead of swapping src — no flash, and it can animate. Only the
			    first is eager; the rest load lazily. */}
			<div class="pcard-track" data-track>
				{
					images.map((img, i) => (
						<img
							src={img.src}
							srcset={img.srcset}
							sizes="(min-width:1024px) 32vw, (min-width:640px) 45vw, 92vw"
							alt={i === 0 ? img.alt || product.name : ''}
							width="640"
							height="640"
							loading={eager && i === 0 ? 'eager' : 'lazy'}
							decoding="async"
							fetchpriority={eager && i === 0 ? 'high' : 'auto'}
						/>
					))
				}
			</div>
		</a>

		{
			images.length > 1 && (
				<div class="pcard-dots">
					{images.map((_, i) => (
						<button data-dot={i} data-active={i === 0 ? 'true' : 'false'} aria-label={`View image ${i + 1}`} />
					))}
				</div>
			)
		}
	</div>

	<div class="pcard-body">
		<h3 class="pcard-title"><a href={href}>{product.name}</a></h3>

		<p class="pcard-tagline">{tagline || cat?.name || 'Single-origin'}</p>

		<p class="pcard-sum">{summary}</p>

		<div class="pcard-foot">
			<p class="pcard-price">
				{
					product.on_sale ? (
						<>
							{formatPrice(product.prices.sale_price, product.prices)}
							<span class="pcard-was">{formatPrice(product.prices.regular_price, product.prices)}</span>
							<span class="pcard-sale">On sale</span>
						</>
					) : (
						formatPrice(product.prices.price, product.prices)
					)
				}
			</p>

			<AddToCart
				client:visible
				id={product.id}
				name={product.name}
				price={Number(product.on_sale ? product.prices.sale_price : product.prices.price)}
				image={image?.thumbnail || image?.src || ''}
				slug={product.slug}
				label="Add"
			/>
		</div>
	</div>
</article>
