---
import CartButton from './cart/CartButton.tsx';

interface Props {
	/** Solid from the top (pages without a dark hero). */
	solid?: boolean;
}
const { solid = false } = Astro.props;

// On the homepage anchors point to sections; elsewhere they jump home first.
const links = [
	{ label: 'Shop', href: solid ? '/#shop' : '#shop' },
	{ label: 'Our Story', href: solid ? '/#story' : '#story' },
	{ label: 'Find Yours', href: solid ? '/#blend' : '#blend' },
	{ label: 'About', href: '/about' },
	{ label: 'Contact', href: '/contact' },
];
---

<header
	id="navbar"
	data-solid={String(solid)}
	data-scrolled={String(solid)}
	class="fixed inset-x-0 top-0 z-50 transition-[background,box-shadow,padding] duration-500"
>
	<nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
		<!-- Wordmark -->
		<a href={solid ? '/' : '#top'} class="flex items-center" aria-label="Wayomile home">
			<img src="/images/vg-logo-hor-w.png" alt="Wayomile" width="1220" height="265" class="logo-on-dark h-9 w-auto sm:h-11" />
			<img src="/images/vg-logo-hor.png" alt="Wayomile" width="1220" height="265" class="logo-on-light h-9 w-auto sm:h-11" />
		</a>

		<!-- Desktop links -->
		<ul class="nav-links absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 rounded-full px-2 py-1.5 lg:flex">
			{
				links.map((l) => (
					<li>
						<a
							href={l.href}
							class="rounded-full px-4 py-1.5 text-sm font-medium transition-colors duration-300 hover:bg-ink/10"
						>
							{l.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="flex items-center gap-2.5">
			<CartButton client:load />

			<!-- Mobile toggle -->
			<button
				id="menu-toggle"
				aria-label="Open menu"
				aria-expanded="false"
				class="nav-word grid h-10 w-10 place-items-center rounded-full transition hover:bg-ink/10 lg:hidden"
			>
				<svg id="menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<line x1="4" y1="8" x2="20" y2="8" /><line x1="4" y1="16" x2="20" y2="16" />
				</svg>
			</button>
		</div>
	</nav>
</header>

<!-- Mobile menu (full screen) · sits OUTSIDE <header> so the header's
     backdrop-filter doesn't become its containing block (which clipped it) -->
	<div
		id="mobile-menu"
		class="pointer-events-none fixed inset-0 z-[60] flex flex-col bg-paper opacity-0 transition-opacity duration-300 lg:hidden"
	>
		<div class="flex items-center justify-between px-5 py-4">
			<img src="/images/vg-logo-hor.png" alt="Wayomile" width="1220" height="265" class="h-9 w-auto" />
			<button
				id="menu-close"
				aria-label="Close menu"
				class="grid h-11 w-11 place-items-center rounded-full text-ink transition hover:bg-ink/10"
			>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
				</svg>
			</button>
		</div>

		<nav class="flex flex-1 flex-col justify-center gap-1 px-6 pb-24">
			{
				links.map((l, i) => (
					<a
						href={l.href}
						class="mobile-link border-b border-ink/10 py-4 text-3xl font-bold leading-tight tracking-tight text-ink"
						style={`--d:${i * 55}ms`}
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="px-6 pb-10">
			<a href="tel:+919633816338" class="text-sm font-medium leading-relaxed text-ink/50 transition hover:text-brand">
				+91 9633816338
			</a>
		</div>
	</div>

<style>
	/* Text colour flips based on scroll state (light over hero video, ink when scrolled) */
	.nav-word,
	.nav-links a {
		color: white;
	}
	#navbar[data-scrolled='true'] .nav-word,
	#navbar[data-scrolled='true'] .nav-links a {
		color: var(--color-ink);
	}

	/* Logo swaps with the same scroll state: white logo over the dark hero,
	   full-colour logo once the navbar goes light (scrolled / inner pages). */
	.logo-on-dark {
		display: block;
	}
	.logo-on-light {
		display: none;
	}
	#navbar[data-scrolled='true'] .logo-on-dark {
		display: none;
	}
	#navbar[data-scrolled='true'] .logo-on-light {
		display: block;
	}
	#navbar[data-scrolled='true'] {
		background: color-mix(in srgb, var(--color-paper) 82%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
	}
	.nav-links {
		background: color-mix(in srgb, white 12%, transparent);
		backdrop-filter: blur(8px);
	}
	#navbar[data-scrolled='true'] .nav-links {
		background: color-mix(in srgb, var(--color-ink) 5%, transparent);
	}

	/* Full-screen mobile menu link stagger */
	#mobile-menu .mobile-link {
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: var(--d, 0ms);
	}
	#mobile-menu.is-open .mobile-link {
		opacity: 1;
		transform: none;
	}
</style>

<script>
	const nav = document.getElementById('navbar')!;
	const toggle = document.getElementById('menu-toggle')!;
	const menu = document.getElementById('mobile-menu')!;
	const closeBtn = document.getElementById('menu-close')!;

	const solid = nav.dataset.solid === 'true';
	const onScroll = () => {
		nav.dataset.scrolled = solid || window.scrollY > 40 ? 'true' : 'false';
	};
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	let openState = false;
	const applyMenu = (open: boolean) => {
		openState = open;
		toggle.setAttribute('aria-expanded', String(open));
		menu.classList.toggle('is-open', open);
		menu.style.opacity = open ? '1' : '0';
		menu.style.pointerEvents = open ? 'auto' : 'none';
		document.body.style.overflow = open ? 'hidden' : '';
		const lenis = (window as any).lenis;
		open ? lenis?.stop() : lenis?.start();
		nav.dataset.scrolled = open || solid || window.scrollY > 40 ? 'true' : 'false';
	};

	const openMenu = () => {
		if (openState) return;
		applyMenu(true);
		history.pushState({ wmMenu: true }, '');
	};
	// Close via a control (button / esc): also unwind the pushed history entry.
	const closeMenu = () => {
		if (!openState) return;
		applyMenu(false);
		if (history.state && (history.state as any).wmMenu) history.back();
	};

	toggle.addEventListener('click', () => (openState ? closeMenu() : openMenu()));
	closeBtn.addEventListener('click', () => closeMenu());

	// Esc closes.
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && openState) closeMenu();
	});

	// Browser back closes (the entry was already popped by the back navigation).
	window.addEventListener('popstate', () => {
		if (openState) applyMenu(false);
	});

	// Link taps: close visually and neutralise the pushed entry without navigating history.
	menu.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			applyMenu(false);
			if (history.state && (history.state as any).wmMenu) history.replaceState(null, '');
		})
	);
</script>
