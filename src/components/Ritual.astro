---
import SteepTimer from './SteepTimer.tsx';
---

<section id="ritual" class="bg-cream px-5 py-24 sm:px-8 sm:py-32">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
			<div>
				<p data-reveal="fade" class="eyebrow text-ink/60">The Ritual</p>
				<h2 data-reveal class="display mt-5 text-[clamp(2rem,5.5vw,3.75rem)] text-ink">
					Steep it <span class="text-brand">just right.</span>
				</h2>
			</div>
			<p data-reveal="fade" class="max-w-sm text-ink/60 text-pretty">
				A tiny brew companion — because great leaves deserve great timing. Fully interactive, just for fun. ✨
			</p>
		</div>

		<div data-reveal class="mt-14 rounded-[2rem] bg-paper p-8 ring-1 ring-ink/5 sm:p-12">
			<SteepTimer client:visible />
		</div>
	</div>
</section>
