---
export const prerender = false;

import LayoutV2 from '../../layouts/LayoutV2.astro';
import OrdersTable from '../../components/admin/OrdersTable.astro';
import { getSupabaseAdmin, isSupabaseAdminConfigured } from '../../lib/supabase';
import { formatINRAmount } from '../../lib/format';

interface OrderRow {
	id: string;
	order_number: string;
	status: string;
	placed_at: string;
	total_amount: number;
	currency: string;
	discount_coupon_code: string | null;
	vstep_reference_id: string | null;
	customers: { full_name: string; mobile_number: string } | null;
}

// India-only store — "today" and daily totals are grouped in IST, not UTC.
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const istDateKey = (iso: string) => new Date(new Date(iso).getTime() + IST_OFFSET_MS).toISOString().slice(0, 10);

const now = new Date();
const todayKey = istDateKey(now.toISOString());
const since7 = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
const since30 = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

let orders: OrderRow[] = [];
let fetchError: string | null = null;

if (isSupabaseAdminConfigured()) {
	const { data, error } = await getSupabaseAdmin()
		.from('orders')
		.select(
			'id, order_number, status, placed_at, total_amount, currency, discount_coupon_code, vstep_reference_id, customers(full_name, mobile_number)'
		)
		.gte('placed_at', since30.toISOString())
		.order('placed_at', { ascending: false });
	if (error) fetchError = error.message;
	else orders = (data as any) ?? [];
} else {
	fetchError = 'Supabase admin client is not configured (missing env vars).';
}

const todays = orders.filter((o) => istDateKey(o.placed_at) === todayKey);
const last7 = orders.filter((o) => new Date(o.placed_at) >= since7);
const last30 = orders; // query is already scoped to the last 30 days

// Total sale per day, most recent first.
const dailyTotalsMap = new Map<string, number>();
for (const o of orders) {
	const key = istDateKey(o.placed_at);
	dailyTotalsMap.set(key, (dailyTotalsMap.get(key) || 0) + Number(o.total_amount));
}
const dailyTotals = [...dailyTotalsMap.entries()].sort((a, b) => b[0].localeCompare(a[0]));

const STATUS_LABEL: Record<string, string> = {
	placed: 'Placed',
	confirmed: 'Confirmed',
	processing: 'Processing',
	dispatched: 'Dispatched',
	out_for_delivery: 'Out for delivery',
	delivered: 'Delivered',
	cancelled: 'Cancelled',
	returned: 'Returned',
	refunded: 'Refunded',
};
---

<LayoutV2 title="Admin — Wayomile" description="Order analytics." hideFooter>
	<main class="wrap page-top sec">
		<div class="head-row">
			<h1 class="d2">Orders</h1>
			<div style="display:flex;gap:0.75rem">
				<a href="/admin/certifications" class="btn btn-outline-light" style="color:var(--ink);border-color:var(--line-2)">
					Certifications
				</a>
				<form action="/api/admin/logout" method="post">
					<button type="submit" class="btn btn-outline-light" style="color:var(--ink);border-color:var(--line-2)">
						Sign out
					</button>
				</form>
			</div>
		</div>

		{
			fetchError && (
				<p class="note" style="margin-top:2rem;border-color:var(--accent);color:var(--accent)">
					Couldn't load orders: {fetchError}
				</p>
			)
		}

		<section style="margin-top:3rem">
			<h2 class="d3">Today ({todays.length})</h2>
			<div style="margin-top:1.5rem">
				<OrdersTable orders={todays} statusLabel={STATUS_LABEL} />
			</div>
		</section>

		<section style="margin-top:3.5rem">
			<h2 class="d3">Last 7 days ({last7.length})</h2>
			<div style="margin-top:1.5rem">
				<OrdersTable orders={last7} statusLabel={STATUS_LABEL} />
			</div>
		</section>

		<section style="margin-top:3.5rem">
			<h2 class="d3">Last 30 days ({last30.length})</h2>
			<div style="margin-top:1.5rem">
				<OrdersTable orders={last30} statusLabel={STATUS_LABEL} />
			</div>
		</section>

		<section style="margin-top:3.5rem;padding-bottom:4rem">
			<h2 class="d3">Total sales per day</h2>
			<div class="admin-table-wrap" style="margin-top:1.5rem">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Date</th>
							<th>Total sales</th>
						</tr>
					</thead>
					<tbody>
						{
							dailyTotals.length === 0 ? (
								<tr>
									<td colspan="2">No orders in the last 30 days.</td>
								</tr>
							) : (
								dailyTotals.map(([date, total]) => (
									<tr>
										<td>
											{date}
											{date === todayKey ? ' (today)' : ''}
										</td>
										<td>{formatINRAmount(total)}</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</section>
	</main>
</LayoutV2>
