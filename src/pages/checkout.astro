---
import LayoutV2 from '../layouts/LayoutV2.astro';
import Checkout from '../components/checkout/Checkout.tsx';
---

<LayoutV2 title="Checkout — Wayomile" hideFooter>
	<main class="wrap page-top sec">
		<a href="/#shop" class="back-link"><span class="arrow">↖</span> Continue shopping</a>

		<h1 class="d2" style="margin-top:1.5rem">Checkout</h1>

		<div style="margin-top:clamp(2.5rem,5vw,3.5rem)">
			<Checkout client:load />
		</div>
	</main>
</LayoutV2>
