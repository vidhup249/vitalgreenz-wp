---
import LayoutV2 from '../layouts/LayoutV2.astro';
---

<LayoutV2 title="Thank you — Wayomile" hideFooter>
	<main class="wrap page-top sec" style="display:grid;place-items:center;min-height:66svh">
		<div style="max-width:46rem;text-align:center">
			<span class="grid-check" aria-hidden="true">
				<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 6 9 17l-5-5" />
				</svg>
			</span>

			<p style="margin-top:2rem;display:flex;justify-content:center">
				<span class="label" data-anim="fade">Order confirmed</span>
			</p>

			<h1 class="d1" data-anim="words" style="margin-top:1.5rem;font-size:clamp(2.4rem,6vw,4rem)">
				Thank you!
			</h1>

			<p class="lede" data-anim="up" style="margin:1.5rem auto 0;max-width:48ch">
				Your payment went through and your order
				<span id="order-ref" class="accent" style="font-weight:600"></span>
				is confirmed. We've emailed your receipt, and your tea will be packed fresh and on its way soon.
			</p>

			<div data-anim="up" style="--anim-delay:120ms;margin-top:2.5rem;display:flex;flex-wrap:wrap;gap:0.65rem;justify-content:center">
				<a href="/#shop" class="btn btn-dark">Continue shopping <span class="arrow">↗</span></a>
				<a href="/contact" class="btn btn-ghost">Need help?</a>
			</div>
		</div>
	</main>
</LayoutV2>

<script is:inline>
	// Show the order number from ?order=… and make sure the basket is emptied.
	const id = new URLSearchParams(location.search).get('order');
	const ref = document.getElementById('order-ref');
	if (id && ref) ref.textContent = ' #' + id;
	try {
		localStorage.removeItem('wayomile:cart');
	} catch (e) {}
</script>
