---
import LayoutV2 from '../layouts/LayoutV2.astro';

const details = [
	{ label: 'Call us', value: '+91 9633816338', href: 'tel:+919633816338' },
	{ label: 'Email', value: 'support@wayomile.in', href: 'mailto:support@wayomile.in' },
	{ label: 'Hours', value: 'Mon–Sat · 9am – 7pm IST', href: null },
];
---

<LayoutV2
	title="Contact — Wayomile"
	description="Get in touch with the Wayomile team. We usually reply within a day."
>
	<main>
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">Contact</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.4rem,6.2vw,4.5rem);max-width:12ch">
					Let's talk <span class="accent">tea.</span>
				</h1>
				<p class="lede" data-anim="up" style="--anim-delay:220ms">
					Questions about a blend, a bulk order, or partnering with us as a grower? Drop us a line —
					we usually reply within a day.
				</p>
			</div>
		</section>

		<section class="wrap sec" style="padding-top:0">
			<div class="split-page">
				<!-- Details -->
				<div data-anim="up">
					<dl class="info-list">
						{
							details.map((d) => (
								<div class="info-row">
									<dt>{d.label}</dt>
									<dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
								</div>
							))
						}
					</dl>

					<div class="note">
						<strong style="display:block;font-weight:600">Are you a small tea grower?</strong>
						<span style="display:block;margin-top:0.35rem;color:var(--mute)">
							We're always looking to partner with family-run gardens. Tell us about yours.
						</span>
					</div>
				</div>

				<!-- Form -->
				<form id="contact-form" data-anim="up" style="--anim-delay:120ms">
					<div class="field-grid two">
						<label class="field-label">
							<span>Name</span>
							<input required name="name" type="text" class="field" placeholder="Your name" />
						</label>
						<label class="field-label">
							<span>Email</span>
							<input required name="email" type="email" class="field" placeholder="you@email.com" />
						</label>
					</div>

					<label class="field-label" style="margin-top:clamp(1.25rem,2.5vw,1.75rem)">
						<span>Subject</span>
						<input name="subject" type="text" class="field" placeholder="What's this about?" />
					</label>

					<label class="field-label" style="margin-top:clamp(1.25rem,2.5vw,1.75rem)">
						<span>Message</span>
						<textarea required name="message" rows="5" class="field" style="resize:none" placeholder="How can we help?"></textarea>
					</label>

					<button type="submit" class="btn btn-dark" style="margin-top:2rem">
						Send message <span class="arrow">↗</span>
					</button>

					<p id="contact-success" class="note" hidden>
						Thanks! Your message is on its way — we'll be in touch soon.
					</p>
				</form>
			</div>
		</section>
	</main>
</LayoutV2>

<script>
	// NOTE: static site — no backend wired yet. Shows a success state on submit.
	// Hook this up to Formspree / a serverless endpoint / WP contact form to deliver mail.
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const success = document.getElementById('contact-success');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		if (success) success.hidden = false;
		form.reset();
	});
</script>
