---
import LayoutV2 from '../layouts/LayoutV2.astro';
import { getProducts } from '../lib/woocommerce';

const products = await getProducts(100);
const pick = (name: string, idx = 0) => products.find((p) => p.name === name)?.images?.[idx];
const imgA = pick('Indian Masala Tea', 0);
const imgB = pick('Premium Rose Tea', 2) || pick('Premium Rose Tea', 0);

const commitments = [
	'Empowering small tea growers',
	'Encouraging zero-chemical farming',
	'Protecting soil health',
	'Promoting sustainable agriculture',
	'Strengthening rural livelihoods',
];
---

<LayoutV2
	title="About — Vital Greenz"
	description="From India's rural farms to your everyday moments. Vital Greenz is a purpose-driven Indian enterprise behind Wayomile premium teas and Flavvo Fresh premium spices."
>
	<main>
		<!-- ============================ INTRO ============================ -->
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">About Us</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.1rem,5vw,3.75rem);max-width:22ch">
					From India's Rural Farms to Your <span class="accent">Everyday Moments!</span>
				</h1>
				<div class="prose" data-anim="up" style="--anim-delay:240ms">
					<p>
						At <strong>Vital Greenz</strong>, we believe that great products begin with great people,
						responsible farming and respect for nature. We are a purpose-driven Indian enterprise
						creating premium food and beverage brands that bring together quality, authenticity,
						sustainability and the rich agricultural heritage of India.
					</p>
					<p><strong>Our journey is led by two distinctive brands.</strong></p>
				</div>
			</div>
		</section>

		<!-- =========================== WAYOMILE ========================== -->
		<section id="wayomile" class="wrap sec" style="padding-top:0">
			<div class="story-grid" style="margin-top:0">
				<div class="story-figs">
					{
						imgA && (
							<figure class="story-fig" data-anim="mask">
								<img
									src={imgA.src}
									srcset={imgA.srcset}
									sizes="(min-width:900px) 28vw, 45vw"
									alt={imgA.alt || 'Wayomile masala tea'}
									width="500"
									height="625"
									loading="lazy"
								/>
							</figure>
						)
					}
					{
						imgB && (
							<figure class="story-fig" data-anim="mask" style="--anim-delay:160ms">
								<img
									src={imgB.src}
									srcset={imgB.srcset}
									sizes="(min-width:900px) 28vw, 45vw"
									alt={imgB.alt || 'Wayomile rose tea'}
									width="500"
									height="625"
									loading="lazy"
								/>
							</figure>
						)
					}
				</div>

				<div data-anim="right">
					<span class="label">Wayomile</span>
					<h2 class="d2" style="margin-top:1.5rem;max-width:18ch">Premium Indian Tea Products</h2>

					<div class="prose" style="margin-top:1.75rem">
						<p>
							Wayomile brings the timeless heritage of premium Indian tea to your cup. Sourced directly
							from the dedicated rural small tea growers and farmer collectives across India, our teas
							are carefully selected to deliver authentic flavour and exceptional quality.
						</p>
						<p>
							Beyond great tea, Wayomile is committed to empowering small tea growers, encouraging
							zero-chemical farming, protecting soil health, promoting sustainable agriculture and
							strengthening rural livelihoods.
						</p>
					</div>

					<ul class="pdp-trust" style="margin-top:2rem">
						{commitments.map((c) => <li>{c}</li>)}
					</ul>

					<p class="reg-note">
						Tea Board of India Tea Mark Registration No: TB|LC|TM|BLF|TR-10007 &amp; TB|LC|TM|KE-10001
						· Buyer Licence: TB|LC|SI-B/10388
					</p>
				</div>
			</div>
		</section>

		<!-- ========================= FLAVVO FRESH ======================== -->
		<section id="flavvo-fresh" class="wrap sec" style="border-top:1px solid var(--line)">
			<div class="split-page">
				<div data-anim="up">
					<span class="label">Flavvo Fresh</span>
					<h2 class="d2" style="margin-top:1.5rem;max-width:16ch">Premium Indian Spices</h2>
				</div>
				<div class="prose" data-anim="up" style="--anim-delay:120ms">
					<p>
						Flavvo Fresh celebrates the vibrant flavours and culinary traditions of India through
						premium spices sourced with a focus on quality, authenticity and responsible sourcing.
						From everyday cooking to special occasions, we bring the richness of authentic Indian
						spices closer to every kitchen.
					</p>
				</div>
			</div>
		</section>

		<!-- ========================== OUR PURPOSE ======================== -->
		<section class="wrap sec" style="border-top:1px solid var(--line)">
			<div class="split-page">
				<div data-anim="up">
					<span class="label">Our Purpose</span>
				</div>
				<div data-anim="up" style="--anim-delay:120ms">
					<h2 class="d3" style="max-width:34ch">
						Every product can create a positive connection between the people who grow it, the people
						who enjoy it and the environment we all share.
					</h2>
					<div class="prose" style="margin-top:1.75rem">
						<p>
							From a refreshing cup of tea to the spices that bring a meal to life, Vital Greenz is
							building Indian brands that taste good, do good and create lasting value.
						</p>
					</div>
					<p class="purpose-line">Empowering Rural Farmers · Preserving Nature · Enriching Lives.</p>
				</div>
			</div>
		</section>

		<!-- ============================ V-STEP =========================== -->
		<section id="v-step" class="wrap sec" style="border-top:1px solid var(--line)">
			<div class="card-dark" data-anim="up" style="padding:clamp(2rem,5vw,4rem)">
				<span class="label label-light">V-STEP</span>
				<h2 class="d2" style="margin-top:1.5rem;max-width:20ch">Earn While You Learn</h2>

				<div class="prose prose-light" style="margin-top:1.75rem;max-width:74ch">
					<p>
						V-STEP is a gender-neutral Earn While You Learn programme designed by Vital Greenz in tune
						with the UGC guidelines and the broader objectives of Kerala's higher education sector,
						particularly in promoting skill development, entrepreneurship, employability, student
						talent and financial self-reliance.
					</p>
					<p>
						V-STEP also creates institutional value by contributing to NAAC accreditation score,
						strengthening industry–academia linkages, fostering industry collaboration and enhancing
						institutional visibility, while empowering students with practical experience,
						entrepreneurship and employability skills and an opportunity to earn while learning.
					</p>
				</div>

				<p class="vstep-contact">
					Institutions are welcome to contact us at
					<a href="tel:+919633846338">+91 96338 46338</a> or
					<a href="mailto:vstep@vitalgreenz.in">vstep@vitalgreenz.in</a>
				</p>
			</div>
		</section>
	</main>
</LayoutV2>
