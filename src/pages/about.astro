---
import LayoutV2 from '../layouts/LayoutV2.astro';
import { getProducts } from '../lib/woocommerce';

const products = await getProducts(100);
const pick = (name: string, idx = 0) => products.find((p) => p.name === name)?.images?.[idx];
const imgA = pick('Indian Masala Tea', 0);
const imgB = pick('Premium Rose Tea', 2) || pick('Premium Rose Tea', 0);

const values = [
	{
		title: 'Empowering Small Tea Growers',
		body: 'We buy directly from family-run gardens at fair prices — no middlemen skimming the margin, more going back to the people who grow the leaf.',
	},
	{
		title: 'Sustainably Cultivated',
		body: 'Grown with responsible practices that protect soil, water and biodiversity — so the gardens that feed us today are thriving tomorrow.',
	},
	{
		title: 'Crafted for Exceptional Taste',
		body: 'Small-batch blended and packed to order. Freshness you can smell the moment you open the pack, and taste in every cup.',
	},
];

const stats = [
	{ value: 6, suffix: '', label: 'Signature blends' },
	{ value: 100, suffix: '%', label: 'Single-origin leaf' },
	{ value: 48, suffix: 'h', label: 'Garden to your pack' },
	{ value: 1200, suffix: '+', label: 'Happy sippers' },
];
---

<LayoutV2
	title="About — Wayomile"
	description="The story behind Wayomile: premium Indian tea, sourced fairly from small growers and packed fresh."
>
	<main>
		<!-- ============================ INTRO ============================ -->
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">Our Story</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.4rem,6.2vw,4.5rem);max-width:16ch">
					Sip the legacy,<br /><span class="accent">taste the tradition.</span>
				</h1>
				<p class="lede" data-anim="up" style="--anim-delay:240ms">
					Wayomile began with a simple belief — that the finest cup starts with fairness. We connect
					small Indian tea gardens directly to your kitchen, with nothing lost in between.
				</p>
			</div>
		</section>

		<!-- ============================ STORY ============================ -->
		<section class="wrap sec" style="padding-top:0">
			<div class="story-grid" style="margin-top:0">
				<div class="story-figs">
					{imgA && (
						<figure class="story-fig" data-anim="mask">
							<img src={imgA.src} srcset={imgA.srcset} sizes="(min-width:900px) 28vw, 45vw"
								alt={imgA.alt || 'Wayomile masala tea'} width="500" height="625" loading="lazy" />
						</figure>
					)}
					{imgB && (
						<figure class="story-fig" data-anim="mask" style="--anim-delay:160ms">
							<img src={imgB.src} srcset={imgB.srcset} sizes="(min-width:900px) 28vw, 45vw"
								alt={imgB.alt || 'Wayomile rose tea'} width="500" height="625" loading="lazy" />
						</figure>
					)}
				</div>

				<div data-anim="right">
					<span class="label">Why we started</span>
					<h2 class="d2" style="margin-top:1.5rem;max-width:16ch">
						Great tea shouldn't cost the grower.
					</h2>
					<div class="prose" style="margin-top:1.75rem">
						<p>
							Too much of the tea on shelves travels through a maze of traders before it reaches a cup —
							losing freshness and fairness along the way. We do it differently: work hand-in-hand with
							small gardens, roast and blend in small batches, and pack only when you order.
						</p>
						<p>No middlemen. No shortcuts. No compromise on taste.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- =========================== VALUES ============================ -->
		<section class="wrap sec">
			<h2 class="d2" data-anim="words" style="max-width:14ch">What we stand for.</h2>

			<div class="trio" data-anim="stagger" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
				{
					values.map((v, i) => (
						<article class="card" style={`--i:${i}`}>
							<div>
								<span class="stat-num" style="font-size:clamp(1.6rem,2.4vw,2rem)">
									{String(i + 1).padStart(2, '0')}
								</span>
								<h3 class="d3" style="margin-top:1.5rem">{v.title}</h3>
							</div>
							<p class="body">{v.body}</p>
						</article>
					))
				}
			</div>
		</section>

		<!-- ============================ STATS ============================ -->
		<section class="wrap sec-tight">
			<div class="stats" data-anim="stagger">
				{
					stats.map((s, i) => (
						<div class="stat" style={`--i:${i}`}>
							<p class="stat-num">
								<span data-countup={String(s.value)} data-suffix={s.suffix}>0{s.suffix}</span>
							</p>
							<p class="stat-label">{s.label}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- ============================= CTA ============================= -->
		<section class="wrap sec">
			<div class="card-dark" data-anim="up" style="padding:clamp(2.5rem,6vw,5rem);text-align:center">
				<h2 class="d2" data-anim="words">Taste the difference.</h2>
				<div style="margin-top:2.25rem;display:flex;justify-content:center">
					<a href="/#shop" class="btn btn-light">Shop the collection <span class="arrow">↗</span></a>
				</div>
			</div>
		</section>
	</main>
</LayoutV2>
