---
/**
 * Copy on this page is the client's supplied text, verbatim. Do not
 * paraphrase, re-case or re-punctuate it — headings, pipes and the
 * registration string are all reproduced exactly as given.
 */
import LayoutV2 from '../layouts/LayoutV2.astro';
import { getProducts } from '../lib/woocommerce';

const products = await getProducts(100);
const pick = (name: string, idx = 0) => products.find((p) => p.name === name)?.images?.[idx];
const imgA = pick('Indian Masala Tea', 0);
const imgB = pick('Premium Rose Tea', 2) || pick('Premium Rose Tea', 0);

// SBOOCH flavours and their regions, exactly as the client listed them —
// including "Gor Keri / Gold Car", which is theirs to correct, not mine.
const flavours: { name: string; region: string }[] = [
	{ name: 'Koshimbir', region: 'Maharashtra' },
	{ name: 'Tulsi & Lemon', region: 'Uttar Pradesh' },
	{ name: 'Gor Keri / Gold Car', region: 'Gujarat' },
	{ name: 'Rasam', region: 'Tamil Nadu' },
	{ name: 'Rice & Pandan', region: 'Odisha' },
	{ name: 'Naga Pepper', region: 'Nagaland' },
];
---

<LayoutV2
	title="About — Vital Greenz"
	description="From India's Rural Farms to Your Everyday Moments! Vital Greenz is a purpose-driven Indian enterprise behind WAYOMILE premium teas, FLAVVO FRESH premium spices and SBOOCH sparkling kombucha."
>
	<main>
		<!-- ============================ INTRO ============================ -->
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">About Us</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.1rem,5vw,3.75rem);max-width:22ch">
					From India's Rural Farms to Your <span class="accent">Everyday Moments!</span>
				</h1>
				<div class="prose" data-anim="up" style="--anim-delay:240ms">
					<p>
						At <strong>Vital Greenz</strong>, we believe that great products begin with{' '}
						<strong>great people, responsible farming and respect for nature</strong>. We are a
						purpose-driven Indian enterprise creating premium food and beverage brands that bring
						together <strong>quality, authenticity, sustainability and the rich agricultural heritage
						of India</strong>.
					</p>
					<p><strong>Our journey is led by two distinctive brands:</strong></p>
				</div>
			</div>
		</section>

		<!-- =========================== WAYOMILE ========================== -->
		<section id="wayomile" class="wrap sec" style="padding-top:0">
			<div class="story-grid" style="margin-top:0">
				<div class="story-figs">
					{
						imgA && (
							<figure class="story-fig" data-anim="mask">
								<img
									src={imgA.src}
									srcset={imgA.srcset}
									sizes="(min-width:900px) 28vw, 45vw"
									alt={imgA.alt || 'WAYOMILE Indian Masala Tea'}
									width="500"
									height="625"
									loading="lazy"
								/>
							</figure>
						)
					}
					{
						imgB && (
							<figure class="story-fig" data-anim="mask" style="--anim-delay:160ms">
								<img
									src={imgB.src}
									srcset={imgB.srcset}
									sizes="(min-width:900px) 28vw, 45vw"
									alt={imgB.alt || 'WAYOMILE Premium Rose Tea'}
									width="500"
									height="625"
									loading="lazy"
								/>
							</figure>
						)
					}
				</div>

				<div data-anim="right">
					<span class="label">WAYOMILE</span>
					<h2 class="d2" style="margin-top:1.5rem;max-width:18ch">Premium Indian Tea Products</h2>

					<div class="prose" style="margin-top:1.75rem">
						<p>
							Wayomile brings the timeless heritage of premium Indian tea to your cup. Sourced directly
							from the dedicated rural small tea growers and farmer collectives across India, our teas
							are carefully selected to deliver authentic flavour and exceptional quality.
						</p>
					</div>

					{/* The client places the registration at the end of the first
					    paragraph, ahead of "Beyond great tea", so it sits here. */}
					<p class="reg-note">
						(Tea Board of India Tea Mark Registration No: TB|LC|TM|BLF|TR-10007 &amp;
						TB|LC|TM|KE-10001 | Buyer Licence: TB|LC|SI-B/10388)
					</p>

					<div class="prose" style="margin-top:1.5rem">
						<p>
							Beyond great tea, Wayomile is committed to empowering small tea growers, encouraging
							zero-chemical farming, protecting soil health, promoting sustainable agriculture and
							strengthening rural livelihoods.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ========================= FLAVVO FRESH ======================== -->
		<section id="flavvo-fresh" class="wrap sec" style="border-top:1px solid var(--line)">
			<div class="split-page">
				<div data-anim="up">
					<span class="label">FLAVVO FRESH</span>
					<h2 class="d2" style="margin-top:1.5rem;max-width:16ch">Premium Indian Spices</h2>
				</div>
				<div class="prose" data-anim="up" style="--anim-delay:120ms">
					<p>
						FLAVVO FRESH celebrates the vibrant flavours and culinary traditions of India through
						premium spices sourced with a focus on quality, authenticity and responsible sourcing.
						From everyday cooking to special occasions, we bring the richness of authentic Indian
						spices closer to every kitchen.
					</p>
				</div>
			</div>
		</section>

		<!-- ============================ SBOOCH =========================== -->
		<section id="sbooch" class="wrap sec" style="border-top:1px solid var(--line)">
			<div class="split-page">
				<div data-anim="up">
					<span class="label">SBOOCH</span>
					<h2 class="d2" style="margin-top:1.5rem;max-width:16ch">About Sbooch Kombucha</h2>
				</div>
				<div class="prose" data-anim="up" style="--anim-delay:120ms">
					<p>
						SBOOCH is India’s first globally awarded sparkling Kombucha brand, crafted by blending
						traditionally fermented Green Tea and Orthodox Black Tea, sourced directly from small tea
						growers, with distinctive, regionally inspired Indian flavours.
					</p>
				</div>
			</div>

			<h3 class="d3 spec-head" data-anim="up">Key Features &amp; Ingredients</h3>

			<ul class="spec-list" data-anim="up" style="--anim-delay:80ms">
				<li>
					Brewed using filtered water, cane sugar, tea, and a live Kombucha culture (SCOBY) with zero
					artificial additives, preservatives or colorings.
				</li>
				<li>
					<strong>Health Benefits:</strong> Non-alcoholic, vegan, gluten-free, low-caffeine and rich in
					antioxidants to support gut health and digestion.
				</li>
				<li>
					<strong>Regional Indian Flavors:</strong> Created using real local ingredients, featuring
					unique varieties such as:
				</li>
			</ul>

			<div class="flavour-grid" data-anim="up" style="--anim-delay:140ms">
				{
					flavours.map((f) => (
						<div class="flavour-cell">
							<p class="flavour-name">{f.name}</p>
							<p class="flavour-region">{f.region}</p>
						</div>
					))
				}
			</div>

			<div class="card-dark award" data-anim="up" style="--anim-delay:200ms">
				<span class="label label-light">Accolades</span>
				<p class="award-line">
					Winner of "Kombucha of the Year" at the 2025 London Beer Competition and recognized at the
					World Kombucha Awards in Spain.
				</p>
			</div>
		</section>

		<!-- ========================== OUR PURPOSE ======================== -->
		<section class="wrap sec" style="border-top:1px solid var(--line)">
			<!-- Wide column first: the statement is the substance here, so it takes
			     the larger side and the supporting copy sits beside it. A label
			     alone in a narrow column left a 473x367 hole. -->
			<div class="split-page wide-left">
				<div data-anim="up">
					<span class="label">Our Purpose</span>
					<h2 class="d3" style="margin-top:1.5rem">
						We believe that every product can create a positive connection between the people who grow
						it, the people who enjoy it and the environment we all share.
					</h2>
				</div>
				<div data-anim="up" style="--anim-delay:120ms">
					<div class="prose">
						<p>
							From a refreshing cup of tea to the spices that bring a meal to life, Vital Greenz is
							building Indian brands that taste good, do good and create lasting value.
						</p>
					</div>
					<p class="purpose-line">Empowering Rural Farmers | Preserving Nature | Enriching Lives.</p>
				</div>
			</div>
		</section>

		<!-- ============================ V-STEP =========================== -->
		<section id="v-step" class="wrap sec" style="border-top:1px solid var(--line)">
			<div class="card-dark vstep" data-anim="up">
				<h2 class="d2" style="max-width:20ch">About V-STEP</h2>

				<!-- Two columns: one block of this length is a wall of text across the
				     full card width. The client supplied it as two paragraphs. -->
				<div class="prose prose-light vstep-body">
					<p>
						V-STEP is a gender neutral Earn While You Learn program designed by Vital Greenz in tune
						with the UGC guidelines and the broader objectives of Kerala's higher education sector,
						particularly in promoting skill development, entrepreneurship, employability, student
						talent and financial self-reliance.
					</p>
					<p>
						V-STEP also creates institutional value by contributing to NAAC accreditation score,
						strengthening industry–academia linkages, fostering industry collaboration and enhancing
						institutional visibility, while empowering students with practical experience,
						entrepreneurship and employability skills and an opportunity to earn while learning.
					</p>
				</div>

				{/* {' '} keeps the space Astro would otherwise swallow before an
				    element that starts on the next line. */}
				<p class="vstep-contact">
					For more information about V-STEP, institutions are welcome to contact us at{' '}
					<a href="tel:+919633846338">+91 96338 46338</a> or{' '}
					<a href="mailto:vstep@vitalgreenz.in">vstep@vitalgreenz.in</a>
				</p>
			</div>
		</section>
	</main>
</LayoutV2>
