---
/**
 * Placeholder business fields ([REGISTERED BUSINESS NAME] etc.) need to be
 * filled in with real registration details before launch — see the note in
 * the PR/handoff. Contact details reuse the addresses already public in the
 * site footer.
 */
import LayoutV2 from '../layouts/LayoutV2.astro';
---

<LayoutV2
	title="Privacy Policy — Wayomile"
	description="How Wayomile / Vital Greenz collects, uses and protects your personal information."
>
	<main>
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">Legal</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.1rem,5vw,3.75rem);max-width:22ch">
					Privacy <span class="accent">Policy</span>
				</h1>
				<p class="lede" data-anim="up" style="--anim-delay:220ms">Last updated: [DATE]</p>
			</div>
		</section>

		<section class="wrap sec" style="padding-top:0">
			<div class="prose measure-wide" data-anim="up">
				<p>
					<strong>[REGISTERED BUSINESS NAME]</strong> ("Vital Greenz", "Wayomile", "we", "us" or "our"),
					with its registered office at <strong>[REGISTERED BUSINESS ADDRESS]</strong>, is committed to
					protecting the privacy of visitors to this website and our customers. This Privacy Policy
					explains what personal information we collect, how we use it, and the choices you have.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Information We Collect</h2>
				<p>When you browse our site, place an order, or contact us, we may collect:</p>
				<ul class="spec-list">
					<li>Contact details — name, email address, phone number, shipping and billing address.</li>
					<li>Order information — items purchased, order value, and payment status.</li>
					<li>
						Payment details processed by our payment partner (PayPal). We do not store your card or
						bank details on our own servers.
					</li>
					<li>
						Technical information — IP address, browser type and basic usage data, collected
						automatically to keep the site working correctly and secure.
					</li>
				</ul>

				<h2 class="d3" style="margin-top:2.5rem">How We Use Your Information</h2>
				<ul class="spec-list">
					<li>To process and deliver your orders, and to communicate with you about them.</li>
					<li>To respond to enquiries sent through our contact form.</li>
					<li>To improve our website, products and customer experience.</li>
					<li>To meet our legal, tax and regulatory obligations.</li>
				</ul>

				<h2 class="d3" style="margin-top:2.5rem">Sharing Your Information</h2>
				<p>
					We do not sell your personal information. We share it only with the service providers needed
					to run our business — for example, our payment processor (PayPal) to complete transactions,
					and courier partners to deliver your order — and only to the extent necessary for those
					services.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Cookies</h2>
				<p>
					Our website may use cookies and similar technologies to keep your cart working correctly and
					to understand how the site is used. You can control cookies through your browser settings.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Data Security</h2>
				<p>
					We take reasonable technical and organisational measures to protect your personal
					information against unauthorised access, loss or misuse.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Your Rights</h2>
				<p>
					You may request access to, correction of, or deletion of your personal information at any
					time by contacting us using the details below.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Grievance Officer</h2>
				<p>
					In accordance with applicable Indian law, the contact details of the Grievance Officer are:
				</p>
				<p>
					<strong>[GRIEVANCE OFFICER NAME]</strong><br />
					Email: <a href="mailto:[GRIEVANCE OFFICER EMAIL]">[GRIEVANCE OFFICER EMAIL]</a><br />
					Address: [REGISTERED BUSINESS ADDRESS]
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Contact Us</h2>
				<p>
					For any questions about this Privacy Policy, write to us at{' '}
					<a href="mailto:support@vitalgreenz.in">support@vitalgreenz.in</a> or call{' '}
					<a href="tel:+919633816338">+91 9633816338</a>.
				</p>
			</div>
		</section>
	</main>
</LayoutV2>
