---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import ProductCardV2 from '../../components/v2/ProductCardV2.astro';
import ProductBuy from '../../components/product/ProductBuy.tsx';
import {
	getProducts,
	getProduct,
	orderProducts,
	formatPrice,
	cleanTerm,
	normalizeBrand,
	type WooProduct,
} from '../../lib/woocommerce';

export async function getStaticPaths() {
	const products = orderProducts(await getProducts(100));
	return products.map((p) => ({
		params: { slug: p.slug },
		props: { id: p.id, list: products },
	}));
}

const { id, list } = Astro.props as { id: number; list: WooProduct[] };
const product = await getProduct(id);

const image = product.images?.[0];
const cat = product.categories.find((c) => c.name.toLowerCase() !== 'uncategorized');
const rating = Math.round(Number(product.average_rating) || 0);

// Attribute (e.g. Quantity) → clean option labels for the buy box.
const attr = product.attributes?.[0];
const options = attr ? attr.terms.map((t) => cleanTerm(t.name)) : [];

const price = Number(product.on_sale ? product.prices.sale_price : product.prices.price);

// Related: same category, excluding this product.
const related = list
	.filter((p) => p.id !== product.id && p.categories.some((c) => cat && c.id === cat.id))
	.slice(0, 3);

const trust = ['Empowering Small Tea Growers', 'Sustainably Cultivated', 'Crafted for Exceptional Taste'];
---

<LayoutV2
	title={`${product.name} — Wayomile`}
	description={normalizeBrand(product.short_description.replace(/<[^>]*>/g, '')).slice(0, 150)}
>
	<main>
		<div class="wrap page-top" style="padding-bottom:clamp(3.5rem,6.5vw,5.75rem)">
			<!-- Breadcrumb -->
			<nav class="crumb" aria-label="Breadcrumb">
				<a href="/">Home</a><span>/</span><a href="/#shop">Shop</a><span>/</span><em>{product.name}</em>
			</nav>

			<div class="pdp">
				<!-- Gallery -->
				<div data-anim="up">
					<div class="pdp-main">
						<img
							id="pdp-main"
							src={image?.src}
							srcset={image?.srcset}
							sizes="(min-width:900px) 45vw, 100vw"
							alt={image?.alt || product.name}
							width="800"
							height="800"
							fetchpriority="high"
						/>
					</div>
					{
						product.images.length > 1 && (
							<div class="pdp-thumbs">
								{product.images.slice(0, 5).map((img, i) => (
									<button class="pdp-thumb" data-active={i === 0 ? 'true' : 'false'} data-src={img.src} data-srcset={img.srcset} aria-label={`View image ${i + 1}`}>
										<img src={img.thumbnail} alt="" loading="lazy" />
									</button>
								))}
							</div>
						)
					}
				</div>

				<!-- Info -->
				<div data-anim="up" style="--anim-delay:120ms">
					{cat && <span class="label">{cat.name}</span>}

					<h1 class="d2" style="margin-top:1.25rem;font-size:clamp(2rem,4.4vw,3.25rem)">{product.name}</h1>

					<div class="pdp-rating">
						<span aria-label={`Rated ${rating} out of 5`}>
							{[1, 2, 3, 4, 5].map((n) => <span style={n <= rating ? '' : 'opacity:0.25'}>★</span>)}
						</span>
						<span>{product.review_count > 0 ? `${product.review_count} reviews` : 'New arrival'}</span>
					</div>

					<p class="pdp-price">
						{
							product.on_sale ? (
								<>
									{formatPrice(product.prices.sale_price, product.prices)}
									<span class="pcard-was">{formatPrice(product.prices.regular_price, product.prices)}</span>
									<span class="pdp-sale">On sale</span>
								</>
							) : (
								formatPrice(product.prices.price, product.prices)
							)
						}
					</p>

					{product.short_description && (
						<div class="prose-tea" set:html={normalizeBrand(product.short_description)} />
					)}

					<ProductBuy
						client:load
						id={product.id}
						name={product.name}
						price={price}
						image={image?.thumbnail || image?.src || ''}
						slug={product.slug}
						optionLabel={attr?.name}
						options={options}
					/>

					<ul class="pdp-trust">
						{trust.map((t) => <li>{t}</li>)}
					</ul>
				</div>
			</div>
		</div>

		<!-- Full description -->
		{
			product.description && (
				<section class="wrap sec" style="border-top:1px solid var(--line)">
					<h2 class="d3" data-anim="up">Details</h2>
					<div class="prose-tea" data-anim="up" style="--anim-delay:100ms;margin-top:1.5rem;max-width:68ch" set:html={normalizeBrand(product.description)} />
				</section>
			)
		}

		<!-- Related -->
		{
			related.length > 0 && (
				<section class="wrap sec" style="border-top:1px solid var(--line)">
					<h2 class="d2" data-anim="words" style="max-width:16ch">You might also like</h2>
					<div class="grid-3" data-anim="stagger" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
						{related.map((p, i) => <ProductCardV2 product={p} index={i} />)}
					</div>
				</section>
			)
		}
	</main>
</LayoutV2>

<script>
	// Gallery thumbnail → swap main image
	const main = document.getElementById('pdp-main') as HTMLImageElement | null;
	const thumbs = document.querySelectorAll<HTMLElement>('.pdp-thumb');
	thumbs.forEach((thumb) => {
		thumb.addEventListener('click', () => {
			if (!main) return;
			const { src, srcset } = thumb.dataset;
			if (src) main.src = src;
			if (srcset) main.srcset = srcset;
			thumbs.forEach((t) => (t.dataset.active = String(t === thumb)));
		});
	});
</script>
