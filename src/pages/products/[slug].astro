---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductBuy from '../../components/product/ProductBuy.tsx';
import {
	getProducts,
	getProduct,
	orderProducts,
	formatPrice,
	cleanTerm,
	normalizeBrand,
	type WooProduct,
} from '../../lib/woocommerce';

export async function getStaticPaths() {
	const products = orderProducts(await getProducts(100));
	return products.map((p) => ({
		params: { slug: p.slug },
		props: { id: p.id, list: products },
	}));
}

const { id, list } = Astro.props as { id: number; list: WooProduct[] };
const product = await getProduct(id);

const image = product.images?.[0];
const cat = product.categories.find((c) => c.name.toLowerCase() !== 'uncategorized');
const rating = Math.round(Number(product.average_rating) || 0);

// Attribute (e.g. Quantity) → clean option labels for the buy box.
const attr = product.attributes?.[0];
const options = attr ? attr.terms.map((t) => cleanTerm(t.name)) : [];

const price = Number(product.on_sale ? product.prices.sale_price : product.prices.price);

// Related: same category, excluding this product.
const related = list
	.filter((p) => p.id !== product.id && p.categories.some((c) => cat && c.id === cat.id))
	.slice(0, 4);
---

<Layout title={`${product.name} — Wayomile`} description={normalizeBrand(product.short_description.replace(/<[^>]*>/g, '')).slice(0, 150)}>
	<main class="bg-cream pt-24">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<!-- Breadcrumb -->
			<nav class="flex items-center gap-2 py-6 text-sm text-ink/50">
				<a href="/" class="transition hover:text-ink">Home</a>
				<span>/</span>
				<a href="/#shop" class="transition hover:text-ink">Shop</a>
				<span>/</span>
				<span class="text-ink">{product.name}</span>
			</nav>

			<div class="grid gap-10 pb-16 md:grid-cols-2 md:gap-14">
				<!-- Gallery -->
				<div data-reveal="left">
					<div class="overflow-hidden rounded-3xl bg-paper ring-1 ring-ink/5">
						<img
							id="pdp-main"
							src={image?.src}
							srcset={image?.srcset}
							sizes="(min-width:768px) 45vw, 100vw"
							alt={image?.alt || product.name}
							width="800"
							height="800"
							fetchpriority="high"
							class="aspect-square w-full object-cover"
						/>
					</div>
					{
						product.images.length > 1 && (
							<div class="mt-4 flex gap-3">
								{product.images.slice(0, 5).map((img) => (
									<button
										class="pdp-thumb h-20 w-20 shrink-0 overflow-hidden rounded-xl bg-paper ring-1 ring-ink/10 transition hover:ring-ink/40"
										data-src={img.src}
										data-srcset={img.srcset}
									>
										<img src={img.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover" />
									</button>
								))}
							</div>
						)
					}
				</div>

				<!-- Info -->
				<div data-reveal="right">
					{cat && <span class="text-sm font-semibold uppercase tracking-wider text-brand">{cat.name}</span>}
					<h1 class="display mt-2 text-[clamp(2rem,5vw,3rem)] text-ink">{product.name}</h1>

					<div class="mt-3 flex items-center gap-3">
						<div class="flex text-saffron" aria-label={`Rated ${rating} out of 5`}>
							{[1, 2, 3, 4, 5].map((n) => <span class={n <= rating ? 'opacity-100' : 'opacity-25'}>★</span>)}
						</div>
						<span class="text-sm text-ink/50">
							{product.review_count > 0 ? `${product.review_count} reviews` : 'New arrival'}
						</span>
					</div>

					<div class="mt-5 flex items-baseline gap-3">
						{
							product.on_sale ? (
								<>
									<span class="text-3xl font-bold text-ink">{formatPrice(product.prices.sale_price, product.prices)}</span>
									<span class="text-lg text-ink/40 line-through">{formatPrice(product.prices.regular_price, product.prices)}</span>
									<span class="rounded-full bg-saffron px-2.5 py-1 text-xs font-bold text-ink">Sale</span>
								</>
							) : (
								<span class="text-3xl font-bold text-ink">{formatPrice(product.prices.price, product.prices)}</span>
							)
						}
					</div>

					{
						product.short_description && (
							<div class="prose-tea mt-5 text-ink/70" set:html={normalizeBrand(product.short_description)} />
						)
					}

					<ProductBuy
						client:load
						id={product.id}
						name={product.name}
						price={price}
						image={image?.thumbnail || image?.src || ''}
						slug={product.slug}
						optionLabel={attr?.name}
						options={options}
					/>

					<!-- Trust row -->
					<ul class="mt-8 grid grid-cols-1 gap-3 border-t border-ink/10 pt-6 text-sm sm:grid-cols-3">
						{
							['Empowering Small Tea Growers', 'Sustainably Cultivated', 'Crafted for Exceptional Taste'].map((t) => (
								<li class="flex items-center gap-2 text-ink/70">
									<span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand text-[10px] text-cream">✓</span>
									{t}
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<!-- Full description -->
			{
				product.description && (
					<section class="border-t border-ink/10 py-14">
						<h2 data-reveal class="display text-2xl text-ink">Details</h2>
						<div class="prose-tea mt-6 max-w-3xl text-ink/75" set:html={normalizeBrand(product.description)} />
					</section>
				)
			}
		</div>

		<!-- Related -->
		{
			related.length > 0 && (
				<section class="border-t border-ink/10 bg-sand px-5 py-20 sm:px-8">
					<div class="mx-auto max-w-6xl">
						<h2 data-reveal class="display text-[clamp(1.6rem,4vw,2.5rem)] text-ink">You might also like</h2>
						<div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
							{related.map((p, i) => (
								<ProductCard product={p} index={i} />
							))}
						</div>
					</div>
				</section>
			)
		}
	</main>
</Layout>

<style>
	.prose-tea :global(p) {
		margin-bottom: 0.85rem;
		line-height: 1.7;
	}
	.prose-tea :global(strong) {
		color: var(--color-ink);
		font-weight: 700;
	}
	.prose-tea :global(ul) {
		margin: 0.75rem 0;
		padding-left: 1.1rem;
		list-style: disc;
	}
	.prose-tea :global(li) {
		margin-bottom: 0.35rem;
	}
</style>

<script>
	// Gallery thumbnail → swap main image
	const main = document.getElementById('pdp-main') as HTMLImageElement | null;
	document.querySelectorAll<HTMLElement>('.pdp-thumb').forEach((thumb) => {
		thumb.addEventListener('click', () => {
			if (!main) return;
			const src = thumb.dataset.src;
			const srcset = thumb.dataset.srcset;
			if (src) main.src = src;
			if (srcset) main.srcset = srcset;
			document.querySelectorAll('.pdp-thumb').forEach((t) => t.classList.remove('ring-ink/40'));
			thumb.classList.add('ring-ink/40');
		});
	});
</script>
