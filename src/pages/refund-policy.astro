---
/**
 * Placeholder business fields ([REGISTERED BUSINESS NAME] etc.) need to be
 * filled in with real registration details before launch — see the note in
 * the PR/handoff.
 */
import LayoutV2 from '../layouts/LayoutV2.astro';
---

<LayoutV2
	title="Refund & Return Policy — Wayomile"
	description="Our policy on returns, replacements and refunds for Wayomile orders."
>
	<main>
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">Legal</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.1rem,5vw,3.75rem);max-width:22ch">
					Refund &amp; <span class="accent">Return Policy</span>
				</h1>
				<p class="lede" data-anim="up" style="--anim-delay:220ms">Last updated: [DATE]</p>
			</div>
		</section>

		<section class="wrap sec" style="padding-top:0">
			<div class="prose measure-wide" data-anim="up">
				<p>
					We want you to love your Wayomile tea. As our products are food items, our returns policy
					is limited to the cases below to keep every cup safe and fresh.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Damaged or Incorrect Items</h2>
				<p>
					If your order arrives damaged, leaking, or you received the wrong item, please contact us
					within <strong>[X]</strong> days of delivery at{' '}
					<a href="mailto:support@wayomile.in">support@wayomile.in</a> with your order number and a
					photo of the item. We'll arrange a replacement or a full refund.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Quality Concerns</h2>
				<p>
					If you're not satisfied with the quality of a product you received, let us know within{' '}
					<strong>[X]</strong> days of delivery. We take quality seriously and will review each case
					individually.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Non-Returnable Items</h2>
				<p>
					For hygiene and food-safety reasons, we cannot accept returns of opened tea, spice or
					kombucha products unless they are damaged, defective, or incorrect on arrival.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Cancellations</h2>
				<p>
					Orders can be cancelled free of charge before they are dispatched. Once an order has
					shipped, it can no longer be cancelled — please follow the returns process above instead.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Refund Timeline</h2>
				<p>
					Approved refunds are issued to your original payment method via PayPal within{' '}
					<strong>[X–X]</strong> business days.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Contact Us</h2>
				<p>
					For any return or refund request, write to{' '}
					<a href="mailto:support@wayomile.in">support@wayomile.in</a> or call{' '}
					<a href="tel:+919633816338">+91 9633816338</a>.
				</p>
			</div>
		</section>
	</main>
</LayoutV2>
