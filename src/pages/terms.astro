---
/**
 * Placeholder business fields ([REGISTERED BUSINESS NAME] etc.) need to be
 * filled in with real registration details before launch — see the note in
 * the PR/handoff.
 */
import LayoutV2 from '../layouts/LayoutV2.astro';
---

<LayoutV2
	title="Terms & Conditions — Wayomile"
	description="The terms and conditions governing your use of the Wayomile website and purchases."
>
	<main>
		<section class="wrap page-top sec">
			<div class="page-head">
				<span class="label" data-anim="fade">Legal</span>
				<h1 class="d1" data-anim="words" style="--anim-delay:60ms;font-size:clamp(2.1rem,5vw,3.75rem);max-width:22ch">
					Terms &amp; <span class="accent">Conditions</span>
				</h1>
				<p class="lede" data-anim="up" style="--anim-delay:220ms">Last updated: [DATE]</p>
			</div>
		</section>

		<section class="wrap sec" style="padding-top:0">
			<div class="prose measure-wide" data-anim="up">
				<p>
					These Terms &amp; Conditions govern your use of this website, operated by{' '}
					<strong>[REGISTERED BUSINESS NAME]</strong> ("Vital Greenz", "Wayomile", "we", "us" or
					"our"), registered office at <strong>[REGISTERED BUSINESS ADDRESS]</strong>{' '}
					(GSTIN: <strong>32AAUFV8064B1ZY</strong>). By using this website or placing an order,
					you agree to these terms.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Products &amp; Pricing</h2>
				<p>
					We make every effort to display our products and prices accurately. Prices are listed in
					Indian Rupees (₹) and are subject to change without notice. In the rare event of a pricing
					error, we reserve the right to cancel the affected order and issue a full refund.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Orders &amp; Payment</h2>
				<p>
					Orders are confirmed once payment is successfully processed through our payment partner,
					PayPal. We reserve the right to refuse or cancel an order at our discretion, including in
					cases of suspected fraud or unavailable stock — in which case any payment taken will be
					refunded in full.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Shipping &amp; Delivery</h2>
				<p>
					See our <a href="/shipping-policy">Shipping Policy</a> for delivery timelines, coverage and
					charges.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Returns &amp; Refunds</h2>
				<p>
					See our <a href="/refund-policy">Refund &amp; Return Policy</a> for details on returns,
					replacements and refunds.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Intellectual Property</h2>
				<p>
					All content on this website — including text, images, logos and the Wayomile, Flavvo Fresh
					and Sbooch brand names — is the property of Vital Greenz and may not be reproduced without
					written permission.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Limitation of Liability</h2>
				<p>
					To the fullest extent permitted by law, Vital Greenz shall not be liable for any indirect,
					incidental or consequential damages arising from the use of this website or our products.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Governing Law</h2>
				<p>
					These terms are governed by the laws of India, and any disputes shall be subject to the
					exclusive jurisdiction of the courts of <strong>[CITY, STATE]</strong>.
				</p>

				<h2 class="d3" style="margin-top:2.5rem">Contact Us</h2>
				<p>
					Questions about these terms can be sent to{' '}
					<a href="mailto:support@vitalgreenz.in">support@vitalgreenz.in</a> or{' '}
					<a href="tel:+919633816338">+91 9633816338</a>.
				</p>
			</div>
		</section>
	</main>
</LayoutV2>
