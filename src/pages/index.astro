---
/**
 * Holding page for "/". Deliberately standalone — it does not use
 * Layout.astro, so it ships no navbar, cart islands or smooth-scroll
 * bundle. The full homepage now lives at /home.
 */
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/construction.css';

const title = 'Wayomile — Coming Soon';
const description =
  'Something good is  brewing. Our new home for premium Indian tea, sourced from small growers, is on its way.';

const base = Astro.site ?? Astro.url;
const ogImage = new URL('/og.png', base).href;
const canonicalURL = new URL(Astro.url.pathname, base).href;

// The headline is split by hand so the entrance runs on CSS alone.
const headline = [
  { text: 'Something', accent: false },
  { text: 'good', accent: false },
  { text: 'is', accent: false, break: true },
  { text: 'brewing.', accent: true },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Wayomile" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wayomile — premium Indian tea" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f1f1ef" />
  </head>

  <body>
    <main class="page">
      <header class="top">
        <span class="logo">
          <img src="/images/vg-logo-hor.png" alt="Wayomile" width="1220" height="265" />
        </span>
        <span class="label">Site under construction</span>
      </header>

      <section class="mid">
        <h1 class="title">
          {
            headline.map((word, i) => (
              <>
                <span class:list={['w', { accent: word.accent }]}>
                  <span style={`--i:${i}`}>{word.text}</span>
                </span>
                {word.break ? <br /> : ' '}
              </>
            ))
          }
        </h1>

        <p class="lede">
          We're putting the finishing touches on the new Wayomile — premium Indian tea, sourced
          straight from small growers and packed the day it ships. Back very soon.
        </p>

        <div class="bar" role="presentation"></div>
      </section>

      <footer class="bottom">
        <div class="links">
          <a href="tel:+919633816338">+91 9633816338</a>
          <a href="mailto:support@wayomile.in">support@wayomile.in</a>
        </div>
        <p class="copy">© {year} Wayomile. All rights reserved.</p>
      </footer>
    </main>
  </body>
</html>
