---
import LayoutV2 from '../layouts/LayoutV2.astro';
import ProductCardV2 from '../components/v2/ProductCardV2.astro';
import FloatingLeaves from '../components/decor/FloatingLeaves.astro';
import GardenHills from '../components/decor/GardenHills.astro';
import { getShopData } from '../lib/woocommerce';

// ---- Data (one fetch, shared by every section) ---------------------------
const { products, categories } = await getShopData();

// Foot marquee — duplicated once for a seamless -50% loop
const marqueeItems = [
	'EMPOWERING SMALL TEA GROWERS',
	'PROMOTING ZERO-CHEMICAL FARMING',
	'PRESERVING SOIL HEALTH',
	'ADVANCING SUSTAINABLE AGRICULTURE',
	'STRENGTHENING RURAL LIVELIHOODS',
	'CRAFTING SAFE & RESPONSIBLE TEA',
];
const marqueeLoop = [...marqueeItems, ...marqueeItems];

// "What Makes WAYOMILE Special?" — two figures, two statements
const facts = [
	{ value: 6, suffix: '+', label: 'Premium Tea Varieties' },
	{ value: 100, suffix: '%', label: 'Indian Tea' },
	{ value: null, suffix: '', label: 'Small Tea Growers at Our Heart' },
	{ value: null, suffix: '', label: 'Tea & Spices' },
	{ value: 6, suffix: '+', label: 'Varieties of Kerala Spices' },
	{ value: 6, suffix: '+', label: 'Flavours of Premium Kombucha' },
];

// Shop filters
const filters = [{ name: 'All', slug: 'all' }, ...categories];

// The three Vital Greenz brands. Their sections live on /about, so the
// links leave this page rather than pointing at anchors that aren't here.
const brands = [
	{ name: 'WAYOMILE', desc: 'Premium Indian Tea Products', href: '/about#wayomile' },
	{ name: 'FLAVVO FRESH', desc: 'Premium Indian Spices', href: '/about#flavvo-fresh' },
	{ name: 'SBOOCH', desc: 'Premium Indian Kombucha', href: '/about#sbooch' },
];

// Testimonials — the client's supplied text, verbatim. Names and cities are
// reproduced exactly as given, punctuation included ("Vikram. S", "Amaya VC").
const quotes = [
	{
		text: 'The saffron tea is wonderfully fresh and beautifully balanced. After experiencing its distinctive taste and quality, I simply stopped going back to supermarket brands.',
		name: 'Sonal Singh',
		role: 'Bengaluru',
	},
	{
		text: 'Exceptional taste, rooted in a meaningful story. Knowing that Wayomile supports small tea growers makes every cup feel even more special.',
		name: 'Vikram. S',
		role: 'Mumbai',
	},
	{
		text: 'Delicate, fragrant and beautifully balanced, Premium Rose Tea combines smooth tea notes with a subtle floral touch, creating a refined and refreshing experience with every sip.',
		name: 'Ananya. C',
		role: 'Delhi',
	},
	{
		text: 'Rich, aromatic and beautifully balanced, Wayomile Masala Tea brings together premium tea with a warm blend of authentic spices. A comforting, flavourful cup that makes every sip truly memorable.',
		name: 'Amaya VC',
		role: 'Kozhikode',
	},
	{
		text: 'A beautifully smooth and refreshing Green Tea with a clean, delicate flavour. Wayomile Premium Loose Leaf Green Tea offers an elegant, authentic tea experience in every sip, while making wellness a naturally enjoyable part of your daily ritual.',
		name: 'Deepthi Jose',
		role: 'Kochi',
	},
	{
		text: 'Rich, smooth and beautifully balanced, Wayomile Premium Loose Leaf Orthodox Black Tea delivers a refined cup with distinctive depth and richness. A truly satisfying black tea experience, from the very first sip to the last.',
		name: 'Gayathri D',
		role: 'Bengaluru',
	},
];

// FAQ — the client's supplied questions and answers, verbatim.
const faqs = [
	{
		q: 'How fresh is the tea when it arrives?',
		a: 'Our teas are carefully packed to preserve their natural freshness, aroma and flavour, so you can enjoy a beautifully fresh and satisfying cup every time.',
	},
	{
		q: 'Where does your tea come from?',
		a: 'Our teas are sourced directly from the small tea growers mainly from Wayanad, Agarthala and Assam supporting responsible sourcing while bringing the authentic flavour of Indian tea to your cup.',
	},
	{
		q: 'Loose Leaf or Granules — Which Should I Choose?',
		a: 'Our Green Tea and Orthodox Black Tea are available in premium Leaf Grade, offering a more refined, smooth and nuanced tea experience. Our other tea varieties are available in Granule form, designed for a quicker brew with a rich and satisfying cup.',
	},
	{
		q: 'What are the shipping options?',
		a: 'We deliver across India. Enjoy free shipping on orders above ₹1500. For orders below ₹1500, a standard shipping charge will be charged.',
	},
];

// FAQPage structured data — lets search engines show these Q&As as rich
// results directly in search, using the same copy rendered below.
const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<LayoutV2 heroOverlay>
	<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<main>
		<!-- ============================ HERO ============================ -->
		<section id="top" class="hero">
			<div class="hero-bg" aria-hidden="true"></div>
			<FloatingLeaves tone="gold" count={5} />
			<GardenHills />

			<div class="wrap hero-inner">
				<div class="hero-copy">
					<span class="label label-light" data-anim="fade" style="--anim-delay:100ms">
						WAYOMILE
					</span>
					<p class="hero-tagline" data-anim="up" style="--anim-delay:200ms">
						Authentic Premium Indian Tea, Rooted in Tradition!
					</p>

					<h1 class="d1 hero-title" data-anim="words" style="--anim-delay:180ms">
						Explore the Taste of<br /><span class="accent">Premium</span> Indian Tea
					</h1>

					<p class="lede hero-lede" data-anim="up" style="--anim-delay:520ms">
						Every leaf tells a story of purity, tradition and exceptional taste — sourced from small
						growers, cultivated sustainably.
					</p>

					</div>

				<!-- Plain <img> from public/ — a single ~270KB JPEG doesn't need the
				     astro:assets pipeline's multi-format/multi-size generation. -->
				<div class="hero-figure" data-anim="up" style="--anim-delay:760ms">
					<img
						src="/images/wayomile-tea-cup-mascot.jpg"
						alt="The Wayomile chai cup mascot giving a thumbs up beside a bowl of whole Indian spices"
						width="1254"
						height="1254"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</section>

		<!-- ========================== ABOUT US ========================== -->
		<section id="story" class="wrap sec">
			<p><span class="label" data-anim="fade">About Us</span></p>

			<h2 class="d2" data-anim="words" style="margin-top:2rem;max-width:20ch;--anim-delay:60ms">
				From India's Rural Farms to Your <span class="accent">Everyday Moments!</span>
			</h2>

			<div class="story-grid">
				<div class="story-figs story-figs--single">
					<figure class="story-fig story-fig--wide" data-anim="mask">
						<img
							src="/images/wayomile-farm-banner.jpg"
							alt="Wayomile: tea pickers on a rural Indian tea garden, whole spices, and a woman enjoying a cup of chai"
							width="1536"
							height="1024"
							loading="lazy"
						/>
					</figure>
				</div>

				<div data-anim="right">
					<div class="prose">
						<p>
							At <strong>Vital Greenz</strong>, we believe that great products begin with{' '}
							<strong>great people, responsible farming and respect for nature</strong>. We are a
							purpose-driven Indian enterprise creating premium food and beverage brands that bring
							together <strong>quality, authenticity, sustainability and the rich agricultural heritage
							of India</strong>.
						</p>
						<p><strong>Our journey is led by three distinctive brands:</strong></p>
					</div>

					{/* The sentence ends on a colon, so the brands it promises follow.
					    Off the About page, each row links to that brand's section there. */}
					<ul class="brand-lead" data-anim="up" style="--anim-delay:200ms">
						{
							brands.map((b) => (
								<li>
									<a href={b.href}>
										<span class="brand-lead-name">{b.name}</span>
										<span class="brand-lead-dash" aria-hidden="true">-</span>
										<span class="brand-lead-desc">{b.desc}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- ========================== STATEMENT ========================= -->
		<section class="wrap sec">
			<article class="card-dark statement" data-anim="up">
				<FloatingLeaves tone="gold" count={4} />
				<GardenHills />
				<h2 class="d2" data-anim="words">From India's Sustainable Tea Gardens to Your Cup</h2>
				<p class="body">
					Carefully selected, thoughtfully crafted and freshly packed to bring you the authentic
					taste and timeless tradition of premium Indian tea.
				</p>
			</article>
		</section>

		<!-- =========================== STATS =========================== -->
		<section class="wrap sec-tight">
			<h2 class="d3" data-anim="up" style="text-align:center">What Makes WAYOMILE Special?</h2>

			<div class="stats" data-anim="stagger" style="margin-top:clamp(2.5rem,5vw,4rem)">
				{
					facts.map((f, i) => (
						<div class="stat" style={`--i:${i}`}>
							{f.value ? (
								<>
									<p class="stat-num">
										<span data-countup={String(f.value)} data-suffix={f.suffix}>0{f.suffix}</span>
									</p>
									<p class="stat-label">{f.label}</p>
								</>
							) : (
								<p class="stat-word">{f.label}</p>
							)}
						</div>
					))
				}
			</div>
		</section>

		<!-- ==================== SHOP / PRODUCT GRID ===================== -->
		<section id="shop" class="wrap sec">
			<div>
				<p><span class="label" data-anim="fade">The Collection</span></p>
				<h2 class="d2" data-anim="words" style="margin-top:2rem;--anim-delay:60ms">
					Explore the Taste of Premium<br /><span class="ghost">Indian Tea</span>
				</h2>
			</div>

			<div class="chips no-scrollbar" data-anim="up" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
				{
					filters.map((f) => (
						<button class="chip" data-filter={f.slug} data-on={f.slug === 'all' ? 'true' : 'false'}>
							{f.name}
						</button>
					))
				}
			</div>

			<div class="grid-3" data-anim="stagger" style="margin-top:clamp(1.75rem,3vw,2.5rem)">
				{products.map((product, i) => <ProductCardV2 product={product} index={i} />)}
			</div>
		</section>

		<!-- ======================= TESTIMONIALS ======================== -->
		<section class="wrap sec">
			<div class="head-row">
				<h2 class="d2" data-anim="words" style="max-width:15ch">
					The Wayomile <span class="ghost">Experience!</span>
				</h2>
				<p class="body head-note" data-anim="up" style="--anim-delay:240ms">
					Real experiences, heartfelt appreciation, and memorable tea moments shared by our tea lovers.
				</p>
			</div>

			<div
				class="quote-carousel"
				data-quote-carousel
				data-anim="up"
				style="margin-top:clamp(2.5rem,5vw,3.5rem)"
			>
				<div class="quote-track no-scrollbar" data-quote-track>
				{
					quotes.map((q, i) => (
						<figure class="quote" style={`--i:${i}`}>
							<span class="quote-mark" aria-hidden="true">&ldquo;</span>
							<blockquote class="quote-text">{q.text}</blockquote>
							<figcaption class="quote-by">
								<span class="quote-avatar">{q.name.charAt(0)}</span>
								<span>
									<span style="display:block;font-size:0.9rem;font-weight:600">{q.name}</span>
									<span style="display:block;font-size:0.85rem;color:var(--faint)">{q.role}</span>
								</span>
							</figcaption>
						</figure>
					))
					}
				</div>

				<div class="quote-nav">
					<button class="q-btn" type="button" data-quote-prev aria-label="Previous testimonials">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
					</button>
					<button class="q-btn" type="button" data-quote-next aria-label="Next testimonials">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
					</button>
				</div>
			</div>
		</section>

		<!-- ============================ FAQ ============================ -->
		<section id="faq" class="wrap sec">
			<div class="faq-grid">
				<div>
					<p><span class="label" data-anim="fade">Got Questions?</span></p>
					<h2 class="d2" data-anim="words" style="margin-top:2rem;--anim-delay:60ms">
						We’re Here to <span class="ghost">Help.</span>
					</h2>
					<p class="body measure" data-anim="up" style="margin-top:2rem;--anim-delay:240ms">
						Everything you need to know about our tea, from sourcing and freshness to delivery and your
						perfect cup.
					</p>
				</div>

				<div class="faq-list" data-anim="stagger">
					{
						faqs.map((f, i) => (
							<details class="faq" style={`--i:${i}`}>
								<summary>
									{f.q}
									<span class="faq-sign" aria-hidden="true" />
								</summary>
								<div class="faq-body">
									<div>
										<p>{f.a}</p>
									</div>
								</div>
							</details>
						))
					}
				</div>
			</div>
		</section>
			<!-- ========================== MARQUEE ========================== -->
		<div class="marquee" aria-label="What we stand for">
			<div class="marquee-track" style="--dur:64s">
				{
					marqueeLoop.map((item) => (
						<span class="marquee-item">
							{item}
							<i />
						</span>
					))
				}
			</div>
		</div>
	</main>
</LayoutV2>

<script>
	// ---- Category filter tabs ----------------------------------------------
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const cards = document.querySelectorAll<HTMLElement>('[data-product]');

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			chips.forEach((c) => (c.dataset.on = String(c === chip)));

			const slug = chip.dataset.filter;
			cards.forEach((card) => {
				const match = slug === 'all' || (card.dataset.category || '').split(' ').includes(slug!);
				if (match) {
					card.style.display = '';
					requestAnimationFrame(() => card.classList.remove('is-hidden'));
				} else {
					card.classList.add('is-hidden');
					setTimeout(() => {
						if (card.classList.contains('is-hidden')) card.style.display = 'none';
					}, 350);
				}
			});
		});
	});
</script>

<script>
	// Testimonial carousel. Scroll position is the single source of truth, so
	// dragging, the buttons and a resize all stay in agreement.
	document.querySelectorAll('[data-quote-carousel]').forEach((root) => {
		const track = root.querySelector('[data-quote-track]');
		const prev = root.querySelector('[data-quote-prev]');
		const next = root.querySelector('[data-quote-next]');
		if (!track || !prev || !next) return;

		// One card plus one gap — measured, not assumed, since the card count
		// per view changes at each breakpoint.
		const step = () => {
			const card = track.querySelector('.quote');
			if (!card) return track.clientWidth;
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
			return card.getBoundingClientRect().width + gap;
		};

		const sync = () => {
			// 1px of slack: fractional widths mean scrollLeft rarely hits the max exactly.
			const max = track.scrollWidth - track.clientWidth - 1;
			prev.disabled = track.scrollLeft <= 0;
			next.disabled = track.scrollLeft >= max;
		};

		prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
		next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
		track.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
		sync();
	});
</script>
