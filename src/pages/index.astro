---
import { Image } from 'astro:assets';
import heroCup from '../assets/hero-tea-cup.png';
import LayoutV2 from '../layouts/LayoutV2.astro';
import ProductCardV2 from '../components/v2/ProductCardV2.astro';
import FinderV2, { type FinderProduct } from '../components/v2/FinderV2.tsx';
import TimerV2 from '../components/v2/TimerV2.tsx';
import { getShopData, stripHtml } from '../lib/woocommerce';

// ---- Data (one fetch, shared by every section) ---------------------------
const { products, categories } = await getShopData();

/** Truncate on a word boundary — a mid-word cut reads as a bug at this scale. */
const clip = (text: string, max: number) => {
	if (text.length <= max) return text;
	const cut = text.slice(0, max);
	const space = cut.lastIndexOf(' ');
	return (space > max * 0.6 ? cut.slice(0, space) : cut).trimEnd().replace(/[.,;:—-]$/, '') + '…';
};

// Foot marquee — duplicated once for a seamless -50% loop
const marqueeItems = [
	'EMPOWERING SMALL TEA GROWERS',
	'PROMOTING ZERO-CHEMICAL FARMING',
	'PRESERVING SOIL HEALTH',
	'ADVANCING SUSTAINABLE AGRICULTURE',
	'STRENGTHENING RURAL LIVELIHOODS',
	'CRAFTING SAFE & RESPONSIBLE TEA',
];
const marqueeLoop = [...marqueeItems, ...marqueeItems];

// "What Makes WAYOMILE Special?" — two figures, two statements
const facts = [
	{ value: 6, suffix: '+', label: 'Premium Tea Varieties' },
	{ value: 100, suffix: '%', label: 'Indian Tea' },
	{ value: null, suffix: '', label: 'Small Tea Growers at Our Heart' },
	{ value: null, suffix: '', label: 'Tea & Spices' },
	{ value: 6, suffix: '+', label: 'Varieties of Kerala Spices' },
	{ value: 6, suffix: '+', label: 'Flavours of Premium Kombucha' },
];

// Shop filters
const filters = [{ name: 'All', slug: 'all' }, ...categories];

// Flavour finder
const finderProducts: FinderProduct[] = products.map((p) => {
	const img = p.images?.[0];
	return {
		id: p.id,
		name: p.name,
		price: Number(p.on_sale ? p.prices.sale_price : p.prices.price),
		image: img?.thumbnail || img?.src || '',
		permalink: `/products/${p.slug}`,
		slug: p.slug,
		summary: clip(stripHtml(p.short_description, 400), 92),
	};
});

// Testimonials — the client's supplied text, verbatim. Names and cities are
// reproduced exactly as given, punctuation included ("Vikram. S", "Amaya VC").
const quotes = [
	{
		text: 'The saffron tea is wonderfully fresh and beautifully balanced. After experiencing its distinctive taste and quality, I simply stopped going back to supermarket brands.',
		name: 'Sonal Singh',
		role: 'Bengaluru',
	},
	{
		text: 'Exceptional taste, rooted in a meaningful story. Knowing that Wayomile supports small tea growers makes every cup feel even more special.',
		name: 'Vikram. S',
		role: 'Mumbai',
	},
	{
		text: 'Delicate, fragrant and beautifully balanced, Premium Rose Tea combines smooth tea notes with a subtle floral touch, creating a refined and refreshing experience with every sip.',
		name: 'Ananya. C',
		role: 'Delhi',
	},
	{
		text: 'Rich, aromatic and beautifully balanced, Wayomile Masala Tea brings together premium tea with a warm blend of authentic spices. A comforting, flavourful cup that makes every sip truly memorable.',
		name: 'Amaya VC',
		role: 'Kozhikode',
	},
	{
		text: 'A beautifully smooth and refreshing Green Tea with a clean, delicate flavour. Wayomile Premium Loose Leaf Green Tea offers an elegant, authentic tea experience in every sip, while making wellness a naturally enjoyable part of your daily ritual.',
		name: 'Deepthi Jose',
		role: 'Kochi',
	},
	{
		text: 'Rich, smooth and beautifully balanced, Wayomile Premium Loose Leaf Orthodox Black Tea delivers a refined cup with distinctive depth and richness. A truly satisfying black tea experience, from the very first sip to the last.',
		name: 'Gayathri D',
		role: 'Bengaluru',
	},
];

// FAQ
const faqs = [
	{
		q: 'How fresh is the tea when it arrives?',
		a: 'We pack every order the day it ships — never from bulk stock sitting on a shelf. From our gardens to your pack in about 48 hours.',
	},
	{
		q: 'Where does your tea come from?',
		a: 'Directly from small, family-run gardens across India. No middlemen — which means fairer prices for growers and a fresher, single-origin cup for you.',
	},
	{
		q: 'Loose leaf or granules — what should I pick?',
		a: 'Loose leaf gives a more nuanced, layered cup; granules brew fast and strong. Most blends come in both, so it comes down to your ritual.',
	},
	{
		q: 'Can I create my own blend?',
		a: 'Yes — head to the Blend Lab above. Choose a base, a flavour and a format, and we blend and pack it to order just for you.',
	},
	{
		q: 'What are the shipping options?',
		a: 'We ship pan-India. Orders over ₹500 ship free; everything else is a flat, transparent rate calculated at checkout.',
	},
];
---

<LayoutV2 heroOverlay>
	<main>
		<!-- ============================ HERO ============================ -->
		<section id="top" class="hero">
			<div class="hero-bg" aria-hidden="true"></div>

			<div class="wrap hero-inner">
				<div class="hero-copy">
					<span class="label label-light" data-anim="fade" style="--anim-delay:100ms">
						WAYOMILE
					</span>
					<p class="hero-tagline" data-anim="up" style="--anim-delay:200ms">
						Authentic Premium Indian Tea, Rooted in Tradition!
					</p>

					<h1 class="d1 hero-title" data-anim="words" style="--anim-delay:180ms">
						Explore the Taste of<br /><span class="accent">Premium</span> Indian Tea
					</h1>

					<p class="lede hero-lede" data-anim="up" style="--anim-delay:520ms">
						Every leaf tells a story of purity, tradition and exceptional taste — sourced from small
						growers, cultivated sustainably.
					</p>

					</div>

				<!-- Cutout. Imported through astro:assets so the 3.4 MB source PNG
				     is emitted as sized WebP variants rather than shipped whole. -->
				<div class="hero-figure" data-anim="up" style="--anim-delay:760ms">
					<Image
						src={heroCup}
						alt="A glass cup of freshly poured Wayomile tea, mid-splash with sugar and mint"
						widths={[420, 640, 900]}
						sizes="(min-width: 900px) 38vw, 70vw"
						format="webp"
						quality={82}
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</section>

		<!-- ========================== ABOUT US ========================== -->
		<section id="story" class="wrap sec">
			<p><span class="label" data-anim="fade">About Us</span></p>

			<h2 class="d2" data-anim="words" style="margin-top:2rem;max-width:20ch;--anim-delay:60ms">
				From India's Rural Farms to Your <span class="accent">Everyday Moments!</span>
			</h2>

			<div class="story-grid">
				<div class="story-figs">
					<figure class="story-fig" data-anim="mask">
						<img
							src="/images/tra-granules.webp"
							alt="Loose tea granules with a spoon and glass jar"
							width="500"
							height="625"
							loading="lazy"
						/>
					</figure>
					<figure class="story-fig" data-anim="mask" style="--anim-delay:160ms">
						<img
							src="/images/tea-pl-sq.webp"
							alt="Pickers hand-plucking fresh leaves on a tea plantation"
							width="500"
							height="625"
							loading="lazy"
						/>
					</figure>
				</div>

				<div data-anim="right">
					<div class="prose">
						<p>
							At <strong>Vital Greenz</strong>, we believe that great products begin with{' '}
							<strong>great people, responsible farming and respect for nature</strong>. We are a
							purpose-driven Indian enterprise creating premium food and beverage brands that bring
							together <strong>quality, authenticity, sustainability and the rich agricultural heritage
							of India</strong>.
						</p>
						<p><strong>Our journey is led by two distinctive brands:</strong></p>
					</div>
				</div>
			</div>
		</section>

		<!-- ========================== STATEMENT ========================= -->
		<section class="wrap sec">
			<article class="card-dark statement" data-anim="up">
				<h2 class="d2" data-anim="words">From India's Sustainable Tea Gardens to Your Cup</h2>
				<p class="body">
					Carefully selected, thoughtfully crafted and freshly packed to bring you the authentic
					taste and timeless tradition of premium Indian tea.
				</p>
			</article>
		</section>

		<!-- =========================== STATS =========================== -->
		<section class="wrap sec-tight">
			<h2 class="d3" data-anim="up" style="text-align:center">What Makes WAYOMILE Special?</h2>

			<div class="stats" data-anim="stagger" style="margin-top:clamp(2.5rem,5vw,4rem)">
				{
					facts.map((f, i) => (
						<div class="stat" style={`--i:${i}`}>
							{f.value ? (
								<>
									<p class="stat-num">
										<span data-countup={String(f.value)} data-suffix={f.suffix}>0{f.suffix}</span>
									</p>
									<p class="stat-label">{f.label}</p>
								</>
							) : (
								<p class="stat-word">{f.label}</p>
							)}
						</div>
					))
				}
			</div>
		</section>

		<!-- ==================== SHOP / PRODUCT GRID ===================== -->
		<section id="shop" class="wrap sec">
			<div>
				<p><span class="label" data-anim="fade">The Collection</span></p>
				<h2 class="d2" data-anim="words" style="margin-top:2rem;--anim-delay:60ms">
					Explore the Taste of<br /><span class="ghost">Indian Tea</span>
				</h2>
			</div>

			<div class="chips no-scrollbar" data-anim="up" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
				{
					filters.map((f) => (
						<button class="chip" data-filter={f.slug} data-on={f.slug === 'all' ? 'true' : 'false'}>
							{f.name}
						</button>
					))
				}
			</div>

			<div class="grid-3" data-anim="stagger" style="margin-top:clamp(1.75rem,3vw,2.5rem)">
				{products.map((product, i) => <ProductCardV2 product={product} index={i} />)}
			</div>
		</section>

		<!-- ====================== FLAVOUR FINDER ======================= -->
		<section id="blend" class="wrap sec">
			<div class="head-row">
				<h2 class="d2" data-anim="words" style="max-width:14ch;--anim-delay:60ms">
					Not sure where to start? <span class="ghost">We'll match you.</span>
				</h2>
				<p class="body head-note" data-anim="up" style="--anim-delay:240ms">
					One tap on the mood you're after and we'll point you to the blend that fits — then drop it
					straight in your basket
				</p>
			</div>

			<div data-anim="up" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
				<FinderV2 client:visible products={finderProducts} />
			</div>
		</section>

		<!-- ========================== RITUAL =========================== -->
		<section id="ritual" class="wrap sec">
			<div class="head-row">
				<h2 class="d2" data-anim="words" style="--anim-delay:60ms">
					Steep it <span class="ghost">just right.</span>
				</h2>
				<p class="body head-note" data-anim="up" style="--anim-delay:240ms">
					A tiny brew companion — because great leaves deserve great timing. Fully interactive, just for
					fun.
				</p>
			</div>

			<div
				class="card"
				data-anim="up"
				style="margin-top:clamp(2.5rem,5vw,3.5rem);padding:clamp(1.75rem,4vw,3.5rem)"
			>
				<TimerV2 client:visible />
			</div>
		</section>

		<!-- ======================= TESTIMONIALS ======================== -->
		<section class="wrap sec">
			<div class="head-row">
				<h2 class="d2" data-anim="words" style="max-width:15ch">
					The Wayomile <span class="ghost">Experience!</span>
				</h2>
				<p class="body head-note" data-anim="up" style="--anim-delay:240ms">
					Real experiences, heartfelt appreciation, and memorable tea moments shared by our tea lovers.
				</p>
			</div>

			<div class="quotes" data-anim="stagger" style="margin-top:clamp(2.5rem,5vw,3.5rem)">
				{
					quotes.map((q, i) => (
						<figure class="quote" style={`--i:${i}`}>
							<span class="quote-mark" aria-hidden="true">&ldquo;</span>
							<blockquote class="quote-text">{q.text}</blockquote>
							<figcaption class="quote-by">
								<span class="quote-avatar">{q.name.charAt(0)}</span>
								<span>
									<span style="display:block;font-size:0.9rem;font-weight:600">{q.name}</span>
									<span style="display:block;font-size:0.85rem;color:var(--faint)">{q.role}</span>
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>

		<!-- ============================ FAQ ============================ -->
		<section id="faq" class="wrap sec">
			<div class="faq-grid">
				<div>
					<p><span class="label" data-anim="fade">Got questions?</span></p>
					<h2 class="d2" data-anim="words" style="margin-top:2rem;--anim-delay:60ms">
						We've got<br /><span class="ghost">answers.</span>
					</h2>
					<p class="body measure" data-anim="up" style="margin-top:2rem;--anim-delay:240ms">
						Everything about freshness, sourcing and how we get tea to your cup.
					</p>
				</div>

				<div class="faq-list" data-anim="stagger">
					{
						faqs.map((f, i) => (
							<details class="faq" style={`--i:${i}`}>
								<summary>
									{f.q}
									<span class="faq-sign" aria-hidden="true" />
								</summary>
								<div class="faq-body">
									<div>
										<p>{f.a}</p>
									</div>
								</div>
							</details>
						))
					}
				</div>
			</div>
		</section>
			<!-- ========================== MARQUEE ========================== -->
		<div class="marquee" aria-label="What we stand for">
			<div class="marquee-track" style="--dur:64s">
				{
					marqueeLoop.map((item) => (
						<span class="marquee-item">
							{item}
							<i />
						</span>
					))
				}
			</div>
		</div>
	</main>
</LayoutV2>

<script>
	// ---- Category filter tabs ----------------------------------------------
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const cards = document.querySelectorAll<HTMLElement>('[data-product]');

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			chips.forEach((c) => (c.dataset.on = String(c === chip)));

			const slug = chip.dataset.filter;
			cards.forEach((card) => {
				const match = slug === 'all' || (card.dataset.category || '').split(' ').includes(slug!);
				if (match) {
					card.style.display = '';
					requestAnimationFrame(() => card.classList.remove('is-hidden'));
				} else {
					card.classList.add('is-hidden');
					setTimeout(() => {
						if (card.classList.contains('is-hidden')) card.style.display = 'none';
					}, 350);
				}
			});
		});
	});
</script>
