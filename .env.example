# Copy to .env for local development. Never commit the real .env file
# (it's already gitignored) — set these in Vercel's dashboard for production.

# ---- WooCommerce / WordPress (products, orders) ---------------------------
PUBLIC_WORDPRESS_URL=https://wp.vitalgreenz.in
# WP Admin -> WooCommerce -> Settings -> Advanced -> REST API -> Add key (Read/Write)
WC_KEY=
WC_SECRET=

# ---- PayPal (checkout) ------------------------------------------------------
# developer.paypal.com -> Apps & Credentials
PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" while testing, "live" once ready for real payments
PAYPAL_ENV=sandbox
PUBLIC_PAYPAL_CURRENCY=INR

# ---- Supabase (V-STEP data, shared with the V-STEP mobile app) ------------
# Supabase project -> Settings -> API
PUBLIC_SUPABASE_URL=
# The "anon" / "public" key — safe to expose to the browser, RLS-restricted.
PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key — SERVER-ONLY, bypasses RLS. Never expose this to
# the browser or commit it. Only used in server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=
