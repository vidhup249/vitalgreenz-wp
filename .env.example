# Copy to .env for local development. Never commit the real .env file
# (it's already gitignored) — set these in Vercel's dashboard for production.

# ---- WooCommerce / WordPress (products, orders) ---------------------------
PUBLIC_WORDPRESS_URL=https://wp.vitalgreenz.in
# WP Admin -> WooCommerce -> Settings -> Advanced -> REST API -> Add key (Read/Write)
WC_KEY=
WC_SECRET=

# ---- PayPal (checkout) ------------------------------------------------------
# developer.paypal.com -> Apps & Credentials
PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" while testing, "live" once ready for real payments
PAYPAL_ENV=sandbox
PUBLIC_PAYPAL_CURRENCY=INR

# ---- Supabase (V-STEP data, shared with the V-STEP mobile app) ------------
# Supabase project -> Settings -> API
PUBLIC_SUPABASE_URL=
# The "anon" / "public" key — safe to expose to the browser, RLS-restricted.
PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key — SERVER-ONLY, bypasses RLS. Never expose this to
# the browser or commit it. Only used in server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin dashboard (/admin) -----------------------------------------------
# Comma-separated allowlist of admin emails. Supabase Auth's user pool is
# SHARED with the V-STEP mobile app — being a valid logged-in user is NOT
# enough to reach /admin; the email must also be in this list. Create each
# admin as a user in Supabase Dashboard -> Authentication -> Users first.
ADMIN_EMAILS=you@vitalgreenz.in

# ---- Government certification badges (PDP, footer, checkout) ---------------
# Only add REAL, verified numbers — these render as live regulatory claims
# (FSSAI/Spices Board/APEDA are legally regulated marks). Leave blank and the
# corresponding badge/line simply doesn't render. The Tea Board of India
# registration is already public (see src/pages/about.astro) so it's hardcoded
# in src/lib/certifications.ts rather than configured here.
PUBLIC_FSSAI_LIC_NO=
PUBLIC_SPICES_BOARD_NO=
PUBLIC_APEDA_REG_NO=
